void hrPrmText(int t, int i, int v, char* b, int n) {
  const HrPrm& p = HR_PRMS[t][i];
  if (p.kind == 1) { snprintf_P(b, n, PSTR("%+d"), v - p.max / 2); return; }
  if (p.kind == 0) { snprintf_P(b, n, PSTR("%d"), v); return; }
  static const char* const W3[3] = {"SAW", "SQUARE", "TRI"};
  static const char* const PERC[3] = {"OFF", "2ND", "3RD"};
  static const char* const LES[3] = {"OFF", "SLOW", "FAST"};
  static const char* const BW[5] = {"12%", "25%", "50%", "TRI", "NOISE"};
  static const char* const ARPN[6] = {"OFF", "OCTAVE", "MAJOR", "MINOR", "FIFTH", "SUS4"};
  static const char* const RAT[15] = {"0.5", "1", "1.5", "2", "2.5", "3", "3.5", "4", "5", "6", "7", "8", "9", "11", "14"};
  const char* w = "?";
  switch (t) {
    case MT_PAW: if (i == 4) { snprintf_P(b, n, PSTR("%d BIT"), 8 - v); return; } snprintf_P(b, n, PSTR("x%d"), v + 1); return;
    case MT_FANG: w = v ? "SQUARE" : "SAW"; break;
    case MT_LUNA: w = (i == 7 ? PERC : LES)[v % 3]; break;
    case MT_DEN: w = W3[v % 3]; break;
    case MT_BLIP: w = i == 0 ? BW[v % 5] : ARPN[v % 6]; break;
    case MT_SPARK: w = RAT[v % 15]; break;
  }
  snprintf_P(b, n, PSTR("%s"), w);
}
int hrPatLen(int s, int p) { int l = HS->m[s].pat[p].len; return l < 1 ? 16 : l > HR_STEPS ? HR_STEPS : l; }
// ---- (4.3) the note pool: every pattern's notes, one after the other (machine 1 A..H, machine 2 A..H, ...) ----
#define hrNotes(s, p) (HS->pool + HS->m[s].pat[p].off)   // (a macro: the IDE's made-up prototypes come before HrNote)
int hrCount(int s, int p) { return HS->m[s].pat[p].n; }
void hrReindex() {                                      // each pattern's place in the pool, from the counts
  uint32_t o = 0;
  for (int s = 0; s < HR_SLOTS; s++) for (int p = 0; p < HR_PATS; p++) {
    HrPat& P = HS->m[s].pat[p];
    if (P.n > HR_NOTES) P.n = HR_NOTES;
    if (o + P.n > (uint32_t)HR_POOL) P.n = HR_POOL - o;
    P.off = o; o += P.n;
  }
  HS->total = o;
}
void hrShiftAfter(int s, int p, int d) {                // (under hrPoolMux) the patterns after (s, p) moved by d notes
  for (int q = s * HR_PATS + p + 1; q < HR_SLOTS * HR_PATS; q++) { HrPat& Q = HS->m[q / HR_PATS].pat[q % HR_PATS]; Q.off += d; }
  HS->total += d;
}
int hrNoteAt(int s, int p, int st, int key) {           // the note covering this step on this key (-1: none)
  HrNote* PN = hrNotes(s, p); int n = hrCount(s, p);
  for (int i = 0; i < n; i++) { HrNote& N = PN[i]; if (N.key == key && st >= N.at && st < N.at + N.len) return i; }
  return -1;
}
int hrAddNote(int s, int p, int at, int len, int key, int fx) {   // -1: the pattern (256) or the song (3,584) is full
  HrPat& P = HS->m[s].pat[p];
  if (P.n >= HR_NOTES || HS->total >= HR_POOL || at < 0 || at >= HR_STEPS) return -1;
  HrNote N; N.at = at; N.len = constrain(len, 1, HR_STEPS - at); N.key = constrain(key, 0, 127); N.fx = fx;
  portENTER_CRITICAL(&hrPoolMux);
  int end = P.off + P.n;
  memmove(HS->pool + end + 1, HS->pool + end, (HS->total - end) * sizeof(HrNote));
  HS->pool[end] = N; P.n++;
  hrShiftAfter(s, p, 1);
  portEXIT_CRITICAL(&hrPoolMux);
  return P.n - 1;
}
void hrDelNote(int s, int p, int i) {                   // (4.3: keeps the others in order)
  HrPat& P = HS->m[s].pat[p];
  if (i < 0 || i >= P.n) return;
  portENTER_CRITICAL(&hrPoolMux);
  int at = P.off + i;
  memmove(HS->pool + at, HS->pool + at + 1, (HS->total - at - 1) * sizeof(HrNote));
  P.n--;
  hrShiftAfter(s, p, -1);
  portEXIT_CRITICAL(&hrPoolMux);
}
void hrClearPat(int s, int p) {
  HrPat& P = HS->m[s].pat[p];
  if (!P.n) return;
  portENTER_CRITICAL(&hrPoolMux);
  int n = P.n, end = P.off + n;
  memmove(HS->pool + P.off, HS->pool + end, (HS->total - end) * sizeof(HrNote));
  P.n = 0;
  hrShiftAfter(s, p, -n);
  portEXIT_CRITICAL(&hrPoolMux);
}
bool hrCopyPat(int s, int from, int to) {               // pattern from -> pattern to (its notes and its loop length)
  if (from == to) return true;
  int n = hrCount(s, from);
  if (HS->total - hrCount(s, to) + n > HR_POOL) return false;
  hrClearPat(s, to);
  HrPat& T = HS->m[s].pat[to];
  portENTER_CRITICAL(&hrPoolMux);
  int at = T.off;
  memmove(HS->pool + at + n, HS->pool + at, (HS->total - at) * sizeof(HrNote));
  T.n = n;
  hrShiftAfter(s, to, n);
  memcpy(HS->pool + T.off, HS->pool + HS->m[s].pat[from].off, n * sizeof(HrNote));   // (from's place already moved if it's after)
  portEXIT_CRITICAL(&hrPoolMux);
  T.len = HS->m[s].pat[from].len;
  return true;
}
bool hrFitsV1() {                                       // can format 1 hold the song? (64 sections, 64 steps, 64 notes)
  if (HS->nsec > HR_SECS1) return false;
  for (int s = 0; s < HR_SLOTS; s++) for (int p = 0; p < HR_PATS; p++) {
    HrPat& Pt = HS->m[s].pat[p];
    if (Pt.n > HR_NOTES1 || Pt.len > HR_STEPS1) return false;
    HrNote* PN = hrNotes(s, p);
    for (int i = 0; i < Pt.n; i++) if (PN[i].at + (PN[i].len ? PN[i].len : 1) > HR_STEPS1) return false;
  }
  return true;
}
