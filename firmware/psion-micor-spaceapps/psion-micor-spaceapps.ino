  memset(m.prm, 0, HR_PRM);
  if (t) memcpy(m.prm, HR_PRE[t][0], HR_PRM);
  if (wasDrum != (t == MT_PAW)) for (int p = 0; p < HR_PATS; p++) hrClearPat(s, p);   // drum hits make no sense as notes
