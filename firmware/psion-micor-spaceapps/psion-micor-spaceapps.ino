// ---------- pages, pop-ups ----------
void hrRedraw() {
  for (int s = 0; s < HR_SLOTS; s++) { hrMeterW[s] = -1; hrVuH[s] = -1; }
  switch (hrPage) {
    case HP_ROLL: hrDrawRoll(); break;
    case HP_SOUND: hrDrawSound(); break;
    case HP_SONG: hrDrawSong(); break;
    case HP_MIX: hrDrawMix(); break;
    case HP_HELP: hrDrawHelp(); break;
    default: hrDrawRack();
  }
  oledDirty = true;
}
void hrGo(int page) {
  if (hrPage == HP_RACK && page != HP_RACK) hrRackFocus = hrFocus;
  hrPage = page; hrEdit = -1; rlNote = -1;
  switch (page) {
    case HP_RACK: hrFocus = hrRackFocus; break;
    case HP_ROLL: hrFocus = 6; rlEnter(); break;
    case HP_SOUND: hrFocus = 4; break;
    case HP_SONG:
      sgRow = constrain(sgRow, 0, HS->nsec - 1); hrFocus = 6 + sgRow * 8;
      if (sgRow < sgTop || sgRow >= sgTop + 12) sgTop = sgRow > 5 ? sgRow - 5 : 0;
      break;
    case HP_MIX: hrFocus = 6 + hrSlot * 4; break;
    default: hrFocus = 0;
  }
  hrRedraw();
}
void hrPlayButton() {
  if (hrPage == HP_RACK) { hrDrawBar(0); hrDrawPos(); for (int s = 0; s < HR_SLOTS; s++) if (HS->m[s].type) { for (int p = 0; p < HR_PATS; p++) hrDrawPatBox(s, p); hrUnitState(s); } }
  else if (hrPage == HP_ROLL || hrPage == HP_SONG) hrDrawBar(1);
  oledDirty = true;
}
void hrStartPlay(int sec) {
  if (!hrOn) hrAudioStart();
  for (int s = 0; s < HR_SLOTS; s++) for (int p = 0; p < HR_PATS; p++) {   // (4.1.4) a fresh start: no "skip once" left
    HrPat& pt = HS->m[s].pat[p];                                          // over, and LIVE REC begins a new take
    { HrNote* PN = HS->pool + pt.off; for (int i = 0; i < pt.n && i < HR_NOTES; i++) PN[i].fx &= hrRec ? ~12 : ~4; }
  }
  hrMetroWant = (P.metro % 3 == 2 || (P.metro % 3 == 1 && hrRec)) ? 1 : 0;
  hrSend(HC_PLAY, hrSongMode ? 1 : 0, sec, (hrRec && P.countIn) ? 1 : 0, 0);   // (LIVE REC: a bar of count-in)
  hrPlay = hrOn; hrPlayAt = millis(); hrShownSec = -1; hrShownStep = 0xFFFFFFFFu;
}
void hrStop() { hrSend(HC_STOP, 0, 0, 0, 0); hrPlay = false; }
void hrTogglePlay() {
  if (hrPlay) hrStop(); else hrStartPlay(0);
  hrPlayButton();
  if (!hrOn) { char b[56]; snprintf_P(b, sizeof b, PSTR("no sound: %s"), hrDacErr); hrHint(b); }
}
