// ---------- the TFT backlight: switchable only when its BL wire goes to a pin (TFT_BL_PIN) ----------
// Full and off are plain HIGH / LOW (no timer interrupts); the levels in between are 1 kHz PWM. The backlight's
// power follows the duty: "3 medium" uses about a third of full.
const uint8_t BL_DUTY[5] = {255, 150, 80, 35, 12};  // 5 full, 4 bright, 3 medium, 2 dim, 1 night
const uint8_t BL_PIN = (uint8_t)(TFT_BL_PIN < 0 ? 0 : TFT_BL_PIN);
uint8_t blNow = 0;                                  // the backlight's duty right now (dim when idle fades it)
void blWrite(int v) { blNow = (uint8_t)v; analogWrite(BL_PIN, TFT_BL_ACTIVE_LOW ? 255 - v : v); }
void blSet(bool on) {
  if (TFT_BL_PIN < 0) return;
  blWrite(on ? BL_DUTY[P.tftBright % 5] : 0);
}
void prefsSave() {
  if (!fsOk) return;
  File f = LittleFS.open(FS("/prefs.bin"), FS("w"));
  if (f) { f.write((const uint8_t*)&P, sizeof P); f.close(); }
}
void prefsLoad() {
  prefsDefaults();
  if (!fsOk) return;
  File f = LittleFS.open(FS("/prefs.bin"), FS("r"));
  if (!f) return;
  Prefs t;
  size_t sz = f.size();
  t = P;
  if (sz >= offsetof(Prefs, gamePal) && sz <= sizeof t && (size_t)f.read((uint8_t*)&t, sz) == sz && t.ver >= 3 && t.ver <= PREFS_VER) {
    uint8_t was = t.ver;
    P = t; P.ver = PREFS_VER;
    if (was < 16) P.sndOut = SOUND_TO_SPEAKER;      // (v16: the speaker became the default)
    if (was < 17) { P.wifiSave = 0; P.cpuMode = 0; P.dimAfter = 2; }   // (v17, 4.0: the battery savers start on)
    if (was < 18) { P.stereo = 1; P.padOn = 1; }                       // (v18, 4.1: stereo + the cross pad)
    if (was < 19) { P.recQuant = P.recGrid = P.quickKeys = 0; P.recLat = 4; P.metro = 1; P.countIn = 1; P.quietRest = 1; }   // (v19, 4.1.4)
    if (was < 20) { P.oledDx = P.oledDy = 0; }                         // (v20, 4.1.5: OLED position)
    P.oledDx = constrain(P.oledDx, -8, 8); P.oledDy = constrain(P.oledDy, -8, 8);
  }
  f.close();
  P.owner[16] = 0;
}
