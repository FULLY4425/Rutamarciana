uint16_t hrBlend(uint16_t a, uint16_t b, int f) {      // mix two colours, f 0 (a) .. 255 (b)
  int r = ((a >> 11) * (255 - f) + (b >> 11) * f) / 255, g = (((a >> 5) & 63) * (255 - f) + ((b >> 5) & 63) * f) / 255,
      bl = ((a & 31) * (255 - f) + (b & 31) * f) / 255;
  return (uint16_t)((r << 11) | (g << 5) | bl);
}
