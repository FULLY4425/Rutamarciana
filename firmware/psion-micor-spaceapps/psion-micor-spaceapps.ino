SemaphoreHandle_t oledMx = nullptr;                 // one at a time on the I2C bus: the OLED task, commands from loop()
TaskHandle_t oledTaskH = nullptr;
portMUX_TYPE oledMux = portMUX_INITIALIZER_UNLOCKED;
uint8_t oledPend[1024], oledSent[1024];             // the newest picture; what the panel shows (as far as we know)
volatile bool oledHasPend = false;
bool oledSentOk = false;                            // false: the next picture goes out whole
struct OledWant { bool on; uint8_t contrast, precharge, vcomh; };   // (4.2.1) how the panel should be set up
