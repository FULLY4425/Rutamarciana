    if (c && btnDown) { P.oledDy = constrain(P.oledDy + (c > 0 ? 1 : -1), -8, 8); btnUsed = true; uiClick(); }
    else if (c) { P.oledDx = constrain(P.oledDx + (c > 0 ? 1 : -1), -8, 8); uiClick(); }
    if (pd == PD_LEFT || pd == PD_RIGHT) { P.oledDx = constrain(P.oledDx + (pd == PD_RIGHT ? 1 : -1), -8, 8); uiClick(); }
    if (pd == PD_UP || pd == PD_DOWN) { P.oledDy = constrain(P.oledDy + (pd == PD_DOWN ? 1 : -1), -8, 8); uiClick(); }
    takePress();
    if (takeShort()) { keep = true; break; }
    if (fLong) { fLong = false; break; }
    delay(10); yield();
  }
  if (!keep) { P.oledDx = ox; P.oledDy = oy; }
  oledDx = P.oledDx; oledDy = P.oledDy;
  prefsSave();
  fPress = fShort = fLong = false; takeClicks();
  oledDirty = true;
}
