int hrUndoTake() {                                      // the notes LIVE REC wrote since PLAY: out again
  int gone = 0;
  portENTER_CRITICAL(&hrPoolMux);                        // (4.3) one pass over the pool, squeezing the take's notes out
  uint32_t w = 0;
  for (int s = 0; s < HR_SLOTS; s++) for (int p = 0; p < HR_PATS; p++) {
    HrPat& pt = HS->m[s].pat[p];
    uint32_t start = w;
    for (int i = 0; i < pt.n; i++) { HrNote N = HS->pool[pt.off + i]; if (N.fx & 8) gone++; else HS->pool[w++] = N; }
    pt.off = start; pt.n = w - start;
  }
  HS->total = w;
  portEXIT_CRITICAL(&hrPoolMux);
  for (int i = 0; i < 8; i++) hrRecKey[i] = -1;
  if (gone) hrDirty = true;
  return gone;
}
void hrLatTest();
void hrRecDo(int r) {
  static const uint8_t FIX[12] = {0, 2, 4, 6, 8, 10, 12, 16, 20, 24, 30, 40};   // (x 5 ms)
  switch (r) {
    case 0: P.recQuant = (P.recQuant + 1) % 3; break;
    case 1: P.recGrid = (P.recGrid + 1) % 3; break;
    case 2: { int i = 0; while (i < 12 && FIX[i] <= P.recLat) i++; P.recLat = i < 12 ? FIX[i] : 0; break; }
    case 3: hrLatTest(); hrRedraw(); hrRecMenu(3); return;
    case 4: P.metro = (P.metro + 1) % 3; break;
    case 5: P.countIn ^= 1; break;
    case 6: P.quickKeys ^= 1; break;
    case 7: {
      int n = hrUndoTake(); hrRedraw();
      char b[40]; snprintf_P(b, sizeof b, n ? PSTR("the last take is gone (%d notes)") : PSTR("no take to undo"), n); hrHint(b);
      return;
    }
    default: hrRedraw(); return;
  }
  prefsSave();
  hrRedraw(); hrRecMenu(r);                             // (stays open on the same line)
}
