inline int wifiPhyMode() {
  uint8_t pr = 0; esp_wifi_get_protocol(WIFI_IF_STA, &pr);
  return (pr & WIFI_PROTOCOL_11N) ? 3 : (pr & WIFI_PROTOCOL_11G) ? 2 : 1;
}
inline void wifiSetPhyMode(int m) {
  esp_wifi_set_protocol(WIFI_IF_STA, m == 1 ? WIFI_PROTOCOL_11B : m == 2 ? (WIFI_PROTOCOL_11B | WIFI_PROTOCOL_11G)
                                     : (WIFI_PROTOCOL_11B | WIFI_PROTOCOL_11G | WIFI_PROTOCOL_11N));
}
const char* resetReasonStr() {
  switch (esp_reset_reason()) {
    case ESP_RST_POWERON: return "power on";
    case ESP_RST_SW: return "restart";
    case ESP_RST_PANIC: return "crash";
    case ESP_RST_INT_WDT: case ESP_RST_TASK_WDT: case ESP_RST_WDT: return "watchdog";
    case ESP_RST_BROWNOUT: return "power dip";
    case ESP_RST_EXT: return "reset pin";
    case ESP_RST_DEEPSLEEP: return "woke from sleep";
    default: return "normal";
  }
}
// The TFT's pixels go through the ESP32's SPI driver (it fills the 64-byte FIFO itself). The ESP8266 code wrote
// the FIFO registers by hand; these keep its calls working: rawBits() = how many bits the next rawSend() sends.
#define SPI1CMD 0
#define SPIBUSY 1
static inline void rawBits(uint32_t bits) { rawLen = bits / 8; }
static inline void rawSend(const uint32_t* w) { SPI.writeBytes((const uint8_t*)w, rawLen); }
// GFXcanvas16 has no virtual destructor, but we only ever delete exact GFXcanvas16 objects: safe
#pragma GCC diagnostic ignored "-Wdelete-non-virtual-dtor"
// On the ESP8266 every "string" sat in RAM unless it was put in flash (PSTR / PROGMEM), and FS("text") copied it
// into a small ring of RAM buffers just long enough to draw it. (4.2) The ESP32 reads flash text where it is, so
// FS("text") is now the text itself: no copy, about 4 KB less code. (None of them is longer than the 63 letters the
// ring kept.) pgmItem(list, k) and fstr() still use the ring.
#define FS(s) (s)
#define NOINLINE __attribute__((noinline))   // keeps a helper's big locals off the caller's stack frame
// (4.2) The TLS library's error texts (about 16 KB of flash) only ever went to debug logs that this build doesn't
// print. This stand-in is found first by the linker, so the texts stay out; the error numbers are all still there.
// (weak: if a later core links its own copy anyway, that one simply wins: no build error.)
extern "C" __attribute__((weak)) void mbedtls_strerror(int errnum, char* buffer, size_t buflen) { if (buflen) snprintf(buffer, buflen, "TLS error -0x%04X", (unsigned)-errnum); }

