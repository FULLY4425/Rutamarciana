// files: the ESP8266's Dir on top of the ESP32's File
struct FSInfo;
class Dir {
  File root, cur;
 public:
  explicit Dir(File r) : root(r) {}
  bool next() { cur = root ? root.openNextFile() : File(); return (bool)cur; }
  String fileName() { return cur ? String(cur.name()) : String(); }
  bool isDirectory() { return cur && cur.isDirectory(); }
  size_t fileSize() { return cur ? cur.size() : 0; }
};
