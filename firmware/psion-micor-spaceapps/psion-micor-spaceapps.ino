  tft.drawFastVLine(77, y, 10, C_INK);
  putText(130, y + 2, 1, C_MID, C_LCD, FS("MOD"));
  tft.drawRect(152, y, 82, 10, E_RULE);
  tft.fillRect(153, y + 2, mdMod * 80 / 127, 6, acc);
  putText(244, y + 2, 1, mdSus ? acc : C_MID, C_LCD, mdSus ? FS("PEDAL ON") : FS("pedal off"));
}
void mdLogDraw() {
  for (int i = 0; i < 9; i++) {
    int y = 106 + i * 12;
    tft.fillRect(0, y, W, 12, C_LCD);
    if (i < mdLogN) putText(4, y + 2, 1, i == 0 ? C_INK : C_MID, C_LCD, mdLog[i]);
