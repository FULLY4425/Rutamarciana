// ================= BLUETOOTH (ESP32): keyboards, mice, gamepads, remotes, MIDI keyboards =================
// Bluetooth Low Energy HID devices (most keyboards, mice, gamepads, presenters and media remotes sold today; older
// "Bluetooth Classic only" ones can't pair). The device's report map - its own description of its keys, buttons and
// axes - is read and parsed, so any layout works. What they do on the Psion:
//   keyboard: letters type into any text box, arrows / Page keys turn, Enter presses, Esc holds (back), Backspace deletes
//   mouse: moving or the wheel turns, left button presses, right button holds
//   gamepad: d-pad / left stick turns (and repeats while held), button 1 presses, button 2 holds
//   media keys: volume up / down = Settings > Volume, play / pause presses
//   MIDI keyboard (Bluetooth LE MIDI, e.g. M-VAVE SMK-37 Pro): plays HOWL RACK (Music); Settings > MIDI monitor shows it
// The radio work runs on NimBLE's own task; it hands simple events to loop() through a small queue (btService).
struct HidField { uint8_t rid, page, flags, size, count, nu; uint16_t bit; int32_t lmin; uint16_t umin, u[6]; };
HidField btF[28];
uint8_t btFN = 0;
NimBLEClient* btClient = nullptr;
volatile bool btBusy = false;
bool btInited = false;
bool btInitedFlag() { return btInited; }
const char* btStep = "";                             // what the last connection attempt got to
struct BtChr { NimBLERemoteCharacteristic* c; uint8_t rid; };
BtChr btChr[8];
uint8_t btChrN = 0;
enum { BE_TURN, BE_PRESS, BE_HOLD, BE_CHAR, BE_DIR, BE_VOL, BE_PAD };
struct BtEv { uint8_t type; int16_t v; };
BtEv btQ[32];
volatile uint8_t btQh = 0, btQt = 0;
void btPush(uint8_t t, int v) { uint8_t n = (btQh + 1) & 31; if (n == btQt) return; btQ[btQh].type = t; btQ[btQh].v = v; btQh = n; }
// ---------- the report map: a HID descriptor parser (input reports only) ----------
void btParseMap(const uint8_t* d, size_t n) {
  btFN = 0;
  uint8_t page = 0, rsize = 0, rcount = 0, rid = 0, nu = 0; int32_t lmin = 0; uint16_t umin = 0, umax = 0, u[6];
  uint16_t bits[8] = {0}; uint8_t ids[8] = {0}, nid = 0;   // input bit offset per report id
  for (size_t i = 0; i < n; ) {
    uint8_t b = d[i++];
    if (b == 0xFE) { if (i + 1 < n) i += 2 + d[i]; continue; }   // a long item: skip
    uint8_t sz = (b & 3) == 3 ? 4 : (b & 3), type = (b >> 2) & 3, tag = b >> 4;
    uint32_t v = 0;
    for (int k = 0; k < sz && i < n; k++) v |= (uint32_t)d[i++] << (8 * k);
    int32_t sv = sz == 1 ? (int8_t)v : sz == 2 ? (int16_t)v : (int32_t)v;
    if (type == 1) {                                 // global
      if (tag == 0) page = v; else if (tag == 1) lmin = sv; else if (tag == 7) rsize = v; else if (tag == 9) rcount = v;
      else if (tag == 8) rid = v;
    } else if (type == 2) {                          // local
      if (tag == 0 && nu < 6) u[nu++] = v; else if (tag == 1) umin = v; else if (tag == 2) umax = v;
    } else if (type == 0) {                          // main
      if (tag == 8) {                                // an input item
        int k = 0; while (k < nid && ids[k] != rid) k++;
        if (k == nid && nid < 8) { ids[nid] = rid; bits[nid++] = 0; }
        if (k < 8) {
          if (!(v & 1) && btFN < 28) {               // (constant = padding)
            HidField& f = btF[btFN++];
            f.rid = rid; f.page = page; f.flags = v; f.size = rsize; f.count = rcount; f.bit = bits[k]; f.lmin = lmin;
            f.nu = nu; memcpy(f.u, u, sizeof u); f.umin = nu ? u[0] : umin;
            (void)umax;
          }
          bits[k] += rsize * rcount;
        }
      }
      if (tag == 8 || tag == 9 || tag == 0xB || tag == 0xA || tag == 0xC) { nu = 0; umin = umax = 0; }
    }
  }
}
int32_t btBits(const uint8_t* d, size_t n, uint16_t at, uint8_t sz, bool sgn) {
  uint32_t v = 0;
  for (int k = 0; k < sz && k < 32; k++) { uint16_t b = at + k; if (b / 8 < n && (d[b / 8] >> (b % 8) & 1)) v |= 1UL << k; }
  if (sgn && sz < 32 && (v >> (sz - 1) & 1)) v |= ~0UL << sz;
  return (int32_t)v;
}
// ---------- keys ----------
const char BT_KEYS[] = "abcdefghijklmnopqrstuvwxyz1234567890\n\x1b\b\t -=[]\\#;'`,./";
const char BT_SHIFT[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()\n\x1b\b\t _+{}|~:\"~<>?";
uint8_t btKeysOld[8];
void btKey(uint8_t k, bool shift) {
  if (k == 0x52) btPush(BE_PAD, PD_UP); else if (k == 0x51) btPush(BE_PAD, PD_DOWN);    // arrows: like the cross pad
  else if (k == 0x50) btPush(BE_PAD, PD_LEFT); else if (k == 0x4F) btPush(BE_PAD, PD_RIGHT);
  else if (k == 0x4E) btPush(BE_TURN, 5); else if (k == 0x4B) btPush(BE_TURN, -5);       // page down / up
  else if (k == 0x29) btPush(BE_HOLD, 0);                                                // Esc = back
  else if (k >= 0x04 && k <= 0x38) btPush(BE_CHAR, (uint8_t)(shift ? BT_SHIFT : BT_KEYS)[k - 4]);
}
// ---------- one input report ----------
uint8_t btBtnOld = 0; int8_t btDirOld = 0; int32_t btMove = 0, btWheel = 0;
void btReport(uint8_t rid, const uint8_t* d, size_t n) {
  uint8_t mods = 0, keys[8] = {0}, nk = 0, btn = 0; int32_t dx = 0, dy = 0, wheel = 0; int hat = -1, ax = 0, ay = 0; bool absAxes = false, any = false;
  for (int i = 0; i < btFN; i++) {
    HidField& f = btF[i];
    if (f.rid != rid) continue;
    any = true;
    bool var = f.flags & 2, rel = f.flags & 4;
    for (int e = 0; e < f.count; e++) {
      int32_t v = btBits(d, n, f.bit + e * f.size, f.size, f.lmin < 0);
      uint16_t use = var ? (f.nu ? f.u[min(e, f.nu - 1)] : f.umin + e) : (uint16_t)v;
      if (f.page == 0x07) { if (var && use >= 0xE0 && use <= 0xE7 && v) mods |= 1 << (use - 0xE0); else if (!var && v && nk < 8) keys[nk++] = v; }
      else if (f.page == 0x09) { if (var && v && use >= 1 && use <= 8) btn |= 1 << (use - 1); else if (!var && v >= 1 && v <= 8) btn |= 1 << (v - 1); }
      else if (f.page == 0x01) {
        if (use == 0x30) { if (rel) dx = v; else { ax = v - (f.lmin < 0 ? 0 : (1 << (f.size - 1))); absAxes = true; } }
        else if (use == 0x31) { if (rel) dy = v; else { ay = v - (f.lmin < 0 ? 0 : (1 << (f.size - 1))); absAxes = true; } }
        else if (use == 0x38) wheel = v;
        else if (use == 0x39) hat = v - f.lmin;
      } else if (f.page == 0x0C && v) {
        uint16_t cu = var ? use : (uint16_t)v;
        if (cu == 0xE9) btPush(BE_VOL, 1); else if (cu == 0xEA) btPush(BE_VOL, -1);
        else if (cu == 0xCD || cu == 0xB0) btPush(BE_PRESS, 0); else if (cu == 0x224) btPush(BE_HOLD, 0);
      }
    }
  }
  if (!any && n >= 8) { mods = d[0]; for (int k = 2; k < 8; k++) if (d[k]) keys[nk++] = d[k]; }   // (no map: a boot keyboard)
  for (int k = 0; k < nk; k++) {                    // keys newly down
    bool was = false; for (int j = 0; j < 8; j++) if (btKeysOld[j] == keys[k]) was = true;
    if (!was) btKey(keys[k], mods & 0x22);
  }
  memset(btKeysOld, 0, sizeof btKeysOld); memcpy(btKeysOld, keys, nk);
  for (int k = 0; k < nk; k++) if (keys[k] == 0x4F || keys[k] == 0x50 || keys[k] == 0x51 || keys[k] == 0x52) btDirOld = 0;
  if (dy || dx) { btMove += dy + dx; }
  if (wheel) btPush(BE_TURN, -wheel);
  uint8_t down = btn & ~btBtnOld;
  if (down & 1) btPush(BE_PRESS, 0);
  if (down & 2) btPush(BE_HOLD, 0);
  if (down & 0xFC) btPush(BE_PRESS, 0);
  btBtnOld = btn;
  int8_t dir = 0;                                    // gamepads: hat or stick held = a direction that repeats
  if (hat >= 0 && hat < 8) dir = (hat >= 1 && hat <= 4) ? 1 : (hat == 0 || hat >= 5) ? -1 : 0;   // right/down +, up/left -
  else if (absAxes) { int32_t big = ax * ax > ay * ay ? ax : ay; if (big > 40) dir = 1; else if (big < -40) dir = -1; }
  if (dir != btDirOld) { btDirOld = dir; btPush(BE_DIR, dir); }
}
void btNotify(NimBLERemoteCharacteristic* c, uint8_t* d, size_t n, bool) {
  btReports++;
  uint8_t rid = 0;
  for (int i = 0; i < btChrN; i++) if (btChr[i].c == c) rid = btChr[i].rid;
  btReport(rid, d, n);
}
// ---------- Bluetooth MIDI ----------
// A BLE MIDI device has one service with one characteristic. Every notification is a packet: a header byte, then
// timestamp + status + data, again and again (running status: data bytes may follow without a new status).
// Notes go straight from here (NimBLE's task) to HOWL RACK's synth - no screen drawing in the way; every message also
// goes to loop() for the monitor, recording and the knobs.
const char* const BT_MIDI_SVC = "03B80E5A-EDE8-4B33-A751-6CE34EC4C700";
const char* const BT_MIDI_IO = "7772E5DB-3868-4112-A1A9-F2669D106BF3";
struct MidiMsg { uint8_t st, d1, d2; uint32_t ms; };
MidiMsg mdQ[64];
volatile uint8_t mdQh = 0, mdQt = 0;
volatile uint32_t mdPackets = 0, mdMsgs = 0, mdClock = 0, mdLost = 0;
uint8_t mdRaw[24];
volatile uint8_t mdRawN = 0;
uint8_t mdSt = 0, mdDat[2], mdDn = 0;
bool mdSysex = false;
// (4.1.4) When did the key really go down? Bluetooth delivers MIDI in little bunches (every 7.5-30 ms), so the time a
// message arrives jitters. Every BLE MIDI message carries the keyboard's own clock (13 bits of milliseconds): arrival
// minus that clock is a fixed offset plus the radio's delay, and its smallest value is the fastest delivery. A message
// that took longer than that was played that much earlier. Used only while the keyboard's clock keeps time with ours
// (mdTsScore > 0: some keyboards send a fixed or wrong stamp); a slow drift is followed (the floor creeps up 0.5 ms/s).
uint32_t mdPktMs = 0;                                // when this packet arrived
uint16_t mdTs = 0;                                   // the keyboard's clock for the message being read
bool mdTsHave = false;
int mdTsScore = 0;
uint32_t mdPressMs() {
  uint32_t arr = mdPktMs;
  if (!mdTsHave) return arr;
  static uint32_t lastArr = 0, minAt = 0; static uint16_t lastTs = 0, dmin = 0; static bool seen = false, haveMin = false;
  if (seen && arr - lastArr > 20 && arr - lastArr < 4000) {   // does its clock keep time with ours?
    int dt = (int)(arr - lastArr), dts = (int)((mdTs - lastTs) & 8191);
    if (abs(dts - dt) < 40) { if (mdTsScore < 20) mdTsScore++; } else if (mdTsScore > -20) mdTsScore -= 2;
  }
  seen = true; lastArr = arr; lastTs = mdTs;
  uint16_t d = (uint16_t)((arr - mdTs) & 8191);
  int late = (int)((d - dmin) & 8191); if (late > 4096) late -= 8192;
  if (!haveMin || late < 0 || late > 300) { dmin = d; minAt = arr; late = 0; haveMin = true; }   // the fastest one yet (or the
                                                     // first, or the keyboard's clock jumped): that's the floor
  else if (arr - minAt > 2000) { dmin = (dmin + 1) & 8191; minAt = arr; if (late > 0) late--; }   // (clock drift)
  if (mdTsScore <= 0 || late > 80) return arr;
  return arr - late;
}
void mdMessage(uint8_t st, uint8_t d1, uint8_t d2) {   // one whole message (NimBLE's task)
  mdMsgs++;
  if (st == 0xF8) { mdClock++; return; }             // tempo clock: only counted
  if (st == 0xFE) return;                            // "still here" pings
  uint8_t t = st & 0xF0;
  bool synthCC = t == 0xB0 && (d1 == 1 || d1 == 64 || d1 == 120 || d1 == 123);   // (other knobs: only the screen needs them)
  if (hrOn && app == APP_MUSIC && (t == 0x80 || t == 0x90 || t == 0xE0 || synthCC)) hrSend(HC_MIDI, hrMidiSlot, st, d1, d2);   // play it now
  uint8_t n = (mdQh + 1) & 63;
  if (n == mdQt) { mdLost++; return; }
  mdQ[mdQh].st = st; mdQ[mdQh].d1 = d1; mdQ[mdQh].d2 = d2; mdQ[mdQh].ms = mdPressMs();   // (4.1.4: when it was played)
  __sync_synchronize();
  mdQh = n;
}
int mdNeed(uint8_t st) {                             // how many data bytes follow this status byte
  uint8_t t = st & 0xF0;
  if (t == 0xC0 || t == 0xD0) return 1;
  if (t < 0xF0) return 2;
  return st == 0xF2 ? 2 : (st == 0xF1 || st == 0xF3) ? 1 : 0;
}
void btMidiParse(const uint8_t* d, size_t n) {
  if (n < 2 || !(d[0] & 0x80)) return;               // (not a BLE MIDI packet)
  bool ts = false;
  uint8_t hi = d[0] & 0x3F, lastLo = 0;              // (4.1.4) the keyboard's clock: 6 high bits here, 7 low per message
  mdTsHave = false;
  for (size_t i = 1; i < n; i++) {
    uint8_t b = d[i];
    if (mdSysex) { if (b == 0xF7) mdSysex = false; continue; }   // system exclusive: skipped
    if (b & 0x80) {
      if (!ts) {                                     // a timestamp: one comes before every status byte
        ts = true;
        uint8_t lo = b & 0x7F;
        if (mdTsHave && lo < lastLo) hi = (hi + 1) & 0x3F;   // (the low bits went round inside this packet)
        lastLo = lo; mdTs = (uint16_t)(hi << 7 | lo); mdTsHave = true;
        continue;
      }
      ts = false;
      if (b >= 0xF8) { mdMessage(b, 0, 0); continue; }   // real-time (clock...): doesn't end running status
      if (b == 0xF0) { mdSysex = true; mdSt = 0; continue; }
      if (b == 0xF7) continue;
      mdSt = b; mdDn = 0;
      if (!mdNeed(b)) { mdMessage(b, 0, 0); mdSt = 0; }
      continue;
    }
    ts = false;
    if (!mdSt) continue;                             // data with no status to belong to
    mdDat[mdDn++] = b;
    int need = mdNeed(mdSt);
    if (mdDn >= need) { mdMessage(mdSt, mdDat[0], need > 1 ? mdDat[1] : 0); mdDn = 0; }
  }
}
void btMidiNotify(NimBLERemoteCharacteristic*, uint8_t* d, size_t n, bool) {
  btReports++; mdPackets++;
  mdPktMs = millis();                                // (4.1.4) when it arrived (its messages say when they were played)
  uint8_t k = n > sizeof mdRaw ? sizeof mdRaw : n;
  memcpy(mdRaw, d, k); mdRawN = k;
  btMidiParse(d, n);
}
// "Measure my delay...": the click plays (no song); tap any key with each click. The middle one of the 8 times you
// were "late" (the radio + the amp + your ears and fingers) becomes the delay fix.
void hrLatTest() {
  if (!hrOn && !hrAudioStart()) return;
  if (hrPlay) hrStop();
  uint16_t acc = hrAcc();
  tft.fillRect(0, TITLE_H, W, H - TITLE_H, HR_BG);
  putText(10, 30, 2, HR_TXT, HR_BG, FS("DELAY TEST"));
  putText(10, 56, 1, HR_TXT, HR_BG, FS("Tap any key on the MIDI keyboard together"));
  putText(10, 68, 1, HR_TXT, HR_BG, FS("with each click, 8 times, as you would play."));
  putText(10, 84, 1, HR_DIM, HR_BG, FS("Hold the knob to stop."));
  mdQt = mdQh;                                         // (old messages don't count)
  hrSend(HC_PLAY, 0, 0, 2, 0);                         // clicks only
  float off[12]; int n = 0;
  uint32_t t0 = millis();
  while (n < 8 && millis() - t0 < 60000) {
    updateButton(); takeClicks(); takePress(); takeShort();
    if (fLong) { fLong = false; break; }
    while (mdQt != mdQh) {
      MidiMsg m = mdQ[mdQt]; __sync_synchronize(); mdQt = (mdQt + 1) & 63;
      if ((m.st & 0xF0) != 0x90 || !m.d2) continue;
      HrPosSnap sn;
      if (!hrPosRead(sn) || !sn.play || sn.g < 2.f) continue;
      float g = hrHeardAt(m.ms, sn, false), beat = 4.f * floorf(g / 4.f + 0.5f);
      float ms = (g - beat) * sn.sl * 1000.f / HR_SR;
      if (fabsf(ms) > 250.f) continue;                 // (not near a click)
      off[n++] = ms;
      char b[24]; snprintf_P(b, sizeof b, PSTR("%d: %+d ms "), n, (int)lroundf(ms));
      putText(10 + ((n - 1) % 4) * 76, 110 + ((n - 1) / 4) * 14, 1, HR_TXT, HR_BG, b);
      tft.fillRect(10, 150, (W - 20) * n / 8, 6, acc);
    }
    delay(5); yield();
  }
  hrSend(HC_STOP, 0, 0, 0, 0);
  fPress = fShort = fLong = false;
  char b[48];
  if (n >= 4) {                                        // the middle one: one stray tap doesn't spoil it
    for (int i = 1; i < n; i++) for (int j = i; j > 0 && off[j] < off[j - 1]; j--) { float t = off[j]; off[j] = off[j - 1]; off[j - 1] = t; }
    float med = n & 1 ? off[n / 2] : (off[n / 2 - 1] + off[n / 2]) * 0.5f;
    P.recLat = (uint8_t)constrain((int)lroundf(med / 5.f), 0, 60); prefsSave();
    snprintf_P(b, sizeof b, PSTR("your delay: %d ms - saved as the fix"), P.recLat * 5);
  } else snprintf_P(b, sizeof b, PSTR("not enough taps: the fix stays %d ms"), P.recLat * 5);
  putText(10, 170, 1, E_MINT, HR_BG, b);
  putText(10, 186, 1, HR_DIM, HR_BG, FS("press the knob"));
  for (uint32_t t = millis(); millis() - t < 15000; ) { updateButton(); if (takeShort() || fLong) break; delay(10); }
  fPress = fShort = fLong = false; takeClicks();
}
bool btLinkMidi(NimBLERemoteService* svc) {         // a MIDI keyboard: listen to its one characteristic
  NimBLERemoteCharacteristic* io = svc->getCharacteristic(NimBLEUUID(BT_MIDI_IO));
  if (!io || !io->canNotify()) { btStep = "MIDI: nothing to listen to"; btClient->disconnect(); return false; }
  if (io->canRead()) io->readValue();                // (the BLE MIDI spec: read it once first - it's empty)
  bool ok = io->subscribe(true, btMidiNotify);
  if (!ok) { btClient->secureConnection(); ok = btClient->isConnected() && io->subscribe(true, btMidiNotify); }   // some want pairing first
  Serial.printf("bt: MIDI device, listening=%d\n", ok);
  if (!ok) { btStep = "MIDI: it didn't let us listen"; btClient->disconnect(); return false; }
  mdSt = 0; mdDn = 0; mdSysex = false;
  btMidi = true; btStep = "connected (MIDI)";
  btConnected = true;
  return true;
}
// ---------- connecting ----------
class BtCallbacks : public NimBLEClientCallbacks {
  void onDisconnect(NimBLEClient*, int) override { btConnected = false; }
};
BtCallbacks btCbs;
bool btLink(const NimBLEAddress& a) {               // connect, encrypt, read the map, subscribe to every input report
  if (!btClient) { btClient = NimBLEDevice::createClient(); btClient->setClientCallbacks(&btCbs, false); btClient->setConnectTimeout(8000); }
  if (btClient->isConnected()) btClient->disconnect();
  Serial.printf("bt: connecting to %s\n", a.toString().c_str());
  if (!btClient->connect(a)) { btStep = "it didn't answer"; Serial.println("bt: no connection"); return false; }
  NimBLERemoteService* midiSvc = btClient->getService(NimBLEUUID(BT_MIDI_SVC));
  if (midiSvc) return btLinkMidi(midiSvc);           // a MIDI keyboard
  btMidi = false;
  bool sec = btClient->secureConnection();
  Serial.printf("bt: connected, secure=%d\n", sec);
  NimBLERemoteService* hid = btClient->getService(NimBLEUUID((uint16_t)0x1812));
  if (!hid) { btStep = "no keyboard/mouse service"; Serial.println("bt: no HID service"); btClient->disconnect(); return false; }
  NimBLERemoteCharacteristic* map = hid->getCharacteristic(NimBLEUUID((uint16_t)0x2A4B));
  size_t mapN = 0;
  if (map) { NimBLEAttValue v = map->readValue(); mapN = v.size(); btParseMap(v.data(), v.size()); } else btFN = 0;
  Serial.printf("bt: report map %u bytes, %u fields\n", (unsigned)mapN, btFN);
  btChrN = 0;
  for (auto* c : hid->getCharacteristics(true)) {
    if (c->getUUID() != NimBLEUUID((uint16_t)0x2A4D) || !c->canNotify() || btChrN >= 8) continue;
    uint8_t rid = 0;
    NimBLERemoteDescriptor* ref = c->getDescriptor(NimBLEUUID((uint16_t)0x2908));
    if (ref) { NimBLEAttValue r = ref->readValue(); if (r.size() >= 2 && r.data()[1] != 1) continue; if (r.size()) rid = r.data()[0]; }
    if (!c->subscribe(true, btNotify)) { Serial.printf("bt: subscribe failed (report %u)\n", rid); continue; }
    btChr[btChrN].c = c; btChr[btChrN].rid = rid; btChrN++;
  }
  Serial.printf("bt: %u input reports\n", btChrN);
  if (!btChrN) { btStep = sec ? "nothing to listen to" : "pairing refused (secure)"; btClient->disconnect(); return false; }
  btStep = "connected";
  btConnected = true;
  return true;
}
extern bool imgStream, sleeping;
void btTask(void*) {                                 // core 0: keeps the paired device connected
  uint32_t wait = 5000;
  for (;;) {
    // (while web video streams, don't try: searching for a device borrows the radio from Wi-Fi for seconds)
    if (P.btOn && P.btName[0] && !btConnected && !btBusy && !imgStream && !sleeping) {
      btBusy = true;
      for (int i = 0; i < 30 && !P.cpuMode && getCpuFrequencyMhz() != 240; i++) vTaskDelay(pdMS_TO_TICKS(10));   // (loop() speeds it up)
      btLink(NimBLEAddress(P.btAddr, P.btType));
      btBusy = false;
      if (btConnected) wait = 5000;
      else { vTaskDelay(pdMS_TO_TICKS(wait)); wait = min(wait * 2, (uint32_t)60000); }   // 5 s, 10 s, 20 s ... a minute
    }
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}
void btApply() {                                     // Settings > Bluetooth on / off (and at boot)
  if (P.btOn && !btInited) {
    radioPrep();                                     // (4.3.1) 240 MHz before the radio starts (see cpuSet)
    btInited = true;
    wifiTune();                                      // (Wi-Fi + Bluetooth share the radio: Wi-Fi must allow power saving)
    NimBLEDevice::init("Psion Micor");
    NimBLEDevice::setSecurityAuth(true, false, true);          // bond (remember each other), no PIN, secure
    NimBLEDevice::setSecurityIOCap(BLE_HS_IO_NO_INPUT_OUTPUT);
    xTaskCreatePinnedToCore(btTask, "bt", 8192, nullptr, 1, nullptr, 0);
  }
  if (!P.btOn && btClient && btClient->isConnected()) btClient->disconnect();
}
void btForget() {
  if (btClient && btClient->isConnected()) btClient->disconnect();
  if (P.btName[0]) NimBLEDevice::deleteBond(NimBLEAddress(P.btAddr, P.btType));
  P.btName[0] = 0; memset(P.btAddr, 0, 6);
}
int btPick(const char* title, const char* const* items, int n) {   // a blocking popup menu (used inside Settings)
  pmShow(title, items, n, appAccent(APP_SETTINGS));
  for (;;) {
    updateButton();
    int c = takeClicks() * ENC_DIR; takePress(); bool sp = takeShort();
    if (fLong) { fLong = false; pmOpen = false; return -1; }
    int r = pmTick(c, sp);
    if (r >= 0) return r;
    delay(5);
  }
}
void btBox(const char* a, const char* b) {
  tft.fillRect(20, 90, 280, 50, E_WHITE); tft.drawRect(20, 90, 280, 50, appAccent(APP_SETTINGS));
  putText(30, 100, 1, C_INK, E_WHITE, a); putText(30, 116, 1, C_MID, E_WHITE, b);
}
void btPairUI() {
  if (!P.btOn) { P.btOn = 1; prefsSave(); }
  btApply();
  btBox(FS("Searching for Bluetooth devices..."), FS("put yours in pairing mode now"));
  while (btBusy) delay(20);
  btBusy = true;
  cpuSet(240);                                       // (4.0: full speed before a link exists, never switched under one)
  NimBLEScan* sc = NimBLEDevice::getScan();
  sc->setActiveScan(true);
  sc->setInterval(100); sc->setWindow(99);           // listen almost all the time
  NimBLEScanResults res = sc->getResults(8000, false);
  static char names[8][28]; static const char* items[9]; static NimBLEAddress addr[8];
  int n = 0, all = res.getCount();
  for (int pass = 0; pass < 2; pass++)               // keyboards, mice, gamepads, MIDI first; then other named devices
    for (int i = 0; i < all && n < 8; i++) {
      const NimBLEAdvertisedDevice* d = res.getDevice(i);
      uint16_t ap = d->getAppearance();
      bool midi = d->isAdvertisingService(NimBLEUUID(BT_MIDI_SVC));
      bool hid = midi || d->isAdvertisingService(NimBLEUUID((uint16_t)0x1812)) || (ap >= 0x03C0 && ap <= 0x03CF);
      std::string nm = d->getName();
      if (pass == 0 ? !hid : (hid || nm.empty())) continue;
      const char* kind = midi ? "MIDI" : ap == 0x03C1 ? "keyboard" : ap == 0x03C2 ? "mouse" : (ap == 0x03C3 || ap == 0x03C4) ? "gamepad" : hid ? "HID" : "?";
      snprintf(names[n], sizeof names[n], "%.18s (%s)", nm.size() ? nm.c_str() : "no name", kind);
      addr[n] = d->getAddress(); items[n] = names[n]; n++;
      Serial.printf("bt: found %s %s\n", names[n - 1], d->getAddress().toString().c_str());
    }
  sc->clearResults();
  if (!n) {
    btBusy = false;
    char b[48]; snprintf_P(b, sizeof b, PSTR("Heard %d devices, none with a name."), all);
    btBox(b, FS("pairing mode on? (press to go back)")); while (!takeShort()) { updateButton(); delay(10); } return;
  }
  items[n] = "Cancel";
  int r = btPick("Pair which one?", items, n + 1);
  if (r < 0 || r >= n) { btBusy = false; return; }
  prDrawAll();
  btBox(FS("Connecting..."), names[r]);
  bool ok = btLink(addr[r]);
  btBusy = false;
  if (ok) {
    memcpy(P.btAddr, addr[r].getVal(), 6); P.btType = addr[r].getType();
    snprintf(P.btName, sizeof P.btName, "%.21s", names[r]);
    char* paren = strstr(P.btName, " ("); if (paren) *paren = 0;
    prefsSave();
    btBox(btMidi ? FS("Connected! Play it in Music (HOWL RACK).") : FS("Connected! It works everywhere now."), FS("(press to go back)"));
  } else { char b[48]; snprintf_P(b, sizeof b, PSTR("Didn't work: %s."), btStep); btBox(b, FS("pairing mode on, close by? (press)")); }
  while (!takeShort()) { updateButton(); delay(10); }
}
// ---------- what the monitor remembers: the last messages, keys down, wheels ----------
char mdLog[10][46];
uint8_t mdLogN = 0;
bool mdHeld[128], mdChanged = true;
int mdBend = 0;
uint8_t mdMod = 0, mdSus = 0;
uint32_t mdPrevMs = 0;
void mdTrack(uint8_t st, uint8_t d1, uint8_t d2, uint32_t ms) {
  uint8_t t = st & 0xF0, ch = (st & 15) + 1;
  char b[40], k[8];
  hrKeyName(d1 & 127, k, sizeof k);
  if (t == 0x90 && d2) { mdHeld[d1 & 127] = true; snprintf_P(b, sizeof b, PSTR("NOTE ON  %s (%d) vel %d"), k, d1, d2); }
  else if (t == 0x80 || t == 0x90) { mdHeld[d1 & 127] = false; snprintf_P(b, sizeof b, PSTR("NOTE OFF %s (%d)"), k, d1); }
  else if (t == 0xA0) snprintf_P(b, sizeof b, PSTR("KEY PRESSURE %s %d"), k, d2);
  else if (t == 0xB0) {
    if (d1 == 1) mdMod = d2; else if (d1 == 64) mdSus = d2 >= 64;
    const char* nm = d1 == 1 ? "mod wheel" : d1 == 7 ? "volume" : d1 == 10 ? "pan" : d1 == 11 ? "expression" : d1 == 64 ? "sustain" : (d1 == 120 || d1 == 123) ? "all off" : "";
    snprintf_P(b, sizeof b, PSTR("CC %d = %d %s"), d1, d2, nm);
  }
  else if (t == 0xC0) snprintf_P(b, sizeof b, PSTR("PROGRAM %d"), d1 + 1);
  else if (t == 0xD0) snprintf_P(b, sizeof b, PSTR("PRESSURE %d"), d1);
  else if (t == 0xE0) { mdBend = ((int)d2 << 7 | d1) - 8192; snprintf_P(b, sizeof b, PSTR("PITCH BEND %+d"), mdBend); }
  else snprintf_P(b, sizeof b, PSTR("SYSTEM %02X %02X %02X"), st, d1, d2);
  uint32_t dt = mdPrevMs ? ms - mdPrevMs : 0;
  mdPrevMs = ms;
  if (dt > 99999) dt = 99999;
  memmove(mdLog[1], mdLog[0], sizeof mdLog[0] * 9);
  if (st >= 0xF0) snprintf_P(mdLog[0], sizeof mdLog[0], PSTR("+%-5lu      %s"), (unsigned long)dt, b);
  else snprintf_P(mdLog[0], sizeof mdLog[0], PSTR("+%-5lu ch%-2d %s"), (unsigned long)dt, ch, b);
  if (mdLogN < 10) mdLogN++;
  mdChanged = true;
}
extern uint32_t lastInputMs;
void btService(uint32_t now) {                       // loop(): the events from the radio task
  static int8_t dir = 0; static uint32_t dirAt = 0;
  while (mdQt != mdQh) {                             // MIDI: the monitor, and HOWL RACK's recording / knobs
    MidiMsg m = mdQ[mdQt];
    __sync_synchronize();
    mdQt = (mdQt + 1) & 63;
    lastInputMs = now;
    mdTrack(m.st, m.d1, m.d2, m.ms);
    if (app == APP_MUSIC) hrMidiUi(m.st, m.d1, m.d2, m.ms);
  }
  while (btQt != btQh) {
    BtEv e = btQ[btQt]; btQt = (btQt + 1) & 31;
    lastInputMs = now;
    switch (e.type) {
      case BE_TURN: noInterrupts(); encCount += e.v * ENC_DIR; interrupts(); break;
      case BE_PAD: if (!padEv) { padEv = (uint8_t)e.v; padRep = 0; } break;
      case BE_PRESS: fPress = true; fShort = true; break;
      case BE_HOLD: fLong = true; break;
      case BE_CHAR:
        if (e.v == '\n') { if (rcTextBox()) kbRemotePush('\n'); else { fPress = true; fShort = true; } }
        else if (e.v == '\b') kbRemotePush('\b');
        else if (e.v != '\t') kbRemotePush((char)e.v);
        break;
      case BE_DIR: dir = e.v; dirAt = now; if (dir) { noInterrupts(); encCount += dir * ENC_DIR; interrupts(); } break;
      case BE_VOL:
        if (e.v > 0) { if (!P.sound) { P.sound = 1; P.volume = 2; } else if (P.volume) P.volume--; }
        else { if (P.sound && P.volume < 2) P.volume++; else P.sound = 0; }
        prefsSave(); soundOn(880); delay(60); soundOff();
        break;
    }
  }
  if (dir && now - dirAt > 350) { dirAt = now - 250; noInterrupts(); encCount += dir * ENC_DIR; interrupts(); }   // held: repeat
  if (btMove) {                                      // a mouse moving: every 24 counts (scaled by "PC mouse moves") = one step
    static const int16_t STEP[5] = {48, 32, 20, 12, 6};
    int st = STEP[P.mMove % 5], k = btMove / st;
    if (k) { btMove -= k * st; noInterrupts(); encCount += k * ENC_DIR; interrupts(); }
  }
}
// ---------- Settings > INPUT > Cross pad test (4.1): each button lights up while it's pressed ----------
void padTestUI() {
  uint16_t acc = appAccent(APP_SETTINGS);
  tft.fillRect(0, TITLE_H, W, H - TITLE_H, C_LCD);
  putText(6, 24, 1, C_INK, C_LCD, FS("CROSS PAD TEST: press each button"));
  putText(6, 36, 1, C_MID, C_LCD, FS("each one: its pin -> GND (all share one GND)"));
  putText(6, 222, 1, C_MID, C_LCD, P.padOn ? FS("hold the knob (or OK) to go back") : FS("the pad is OFF in Settings: turn it on"));
  static const int8_t PINS[5] = {PAD_UP, PAD_DOWN, PAD_LEFT, PAD_RIGHT, PAD_OK};
  static const int16_t BX[5] = {125, 125, 45, 205, 125}, BY[5] = {54, 160, 107, 107, 107};
  static const char* const NM[5] = {"UP", "DOWN", "LEFT", "RIGHT", "OK"};
  static const char* const PN[5] = {"D19", "TX2=D17", "RX2=D16", "D15", "D33"};
  uint16_t last = 0xFFFF;
  for (;;) {
    // what's closed (raw pins: the buttons light up) and what the Psion counts it as (4.1.1: the first to close wins)
    uint8_t cnt = padScan(), st = 0;
    for (int i = 0; i < 5; i++) if (PINS[i] >= 0 && digitalRead(PINS[i]) == LOW) st |= 1 << i;
    uint8_t as = cnt | (padOkSt == 2 ? 16 : 0);
    uint16_t key = st | as << 5 | (padOkSt == 1 ? 1 << 10 : 0);
    if (key != last) {
      for (int i = 0; i < 5; i++) {
        bool on = st >> i & 1;
        uint16_t bg = on ? acc : E_WHITE, fg = on ? E_ONACC : C_INK;
        tft.fillRoundRect(BX[i], BY[i], 70, 44, 6, bg); tft.drawRoundRect(BX[i], BY[i], 70, 44, 6, on ? acc : E_RULE);
        putText(BX[i] + (70 - (int)strlen(NM[i]) * 12) / 2, BY[i] + 8, 2, fg, bg, NM[i]);
        putText(BX[i] + (70 - (int)strlen(PN[i]) * 6) / 2, BY[i] + 30, 1, on ? fg : C_MID, bg, PN[i]);
      }
      char b[96] = "";                               // "closed: UP + OK  -> counts as: UP"
      auto add = [&](const char* s) { size_t n = strlen(b); strncpy(b + n, s, sizeof b - 1 - n); b[sizeof b - 1] = 0; };
      if (st) {
        add("closed:");
        for (int i = 0, k = 0; i < 5; i++) if (st >> i & 1) { add(k++ ? " + " : " "); add(NM[i]); }
        add("  -> counts as:");
        if (!as) add(padOkSt == 1 ? " (wait)" : " nothing");
        for (int i = 0, k = 0; i < 5; i++) if (as >> i & 1) { add(k++ ? " + " : " "); add(NM[i]); }
      }
      tft.fillRect(0, 208, W, 10, C_LCD);
      putText(6, 209, 1, (st & (st - 1)) ? E_CORAL : C_INK, C_LCD, b);   // two or more closed at once: in red
      if (st & ~last & 0x1F) uiClick();
      last = key;
    }
    updateButton(); takeClicks(); takePress(); takeShort();
    if (fLong) { fLong = false; break; }
    delay(15); yield();
  }
  fPress = fShort = false;
}
// ---------- Settings > SOUND > Sound test: which way of making sound reaches the speaker? ----------
// First the DAC's own state, read back from its registers (and a multimeter check: D25 at ~1.6 V = the DAC is on),
// then a 440 Hz tone made 4 ways, one after the other: what you hear tells which link is broken.
int stKey() {                                        // 0 nothing, 1 press (next), 2 hold (stop)
  updateButton(); takeClicks(); takePress();
  if (fLong) { fLong = false; return 2; }
  return takeShort() ? 1 : 0;
}
void stLine(int y, uint16_t c, const char* s) { tft.fillRect(0, y, W, 12, C_LCD); putText(6, y + 2, 1, c, C_LCD, s); }
void stState(int y) {                                // the DAC's registers, on screen + Serial
  uint32_t pad = READ_PERI_REG(RTC_IO_PAD_DAC1_REG), c1 = READ_PERI_REG(SENS_SAR_DAC_CTRL1_REG), c2 = READ_PERI_REG(SENS_SAR_DAC_CTRL2_REG);
  char b[64];
  snprintf(b, sizeof b, "DAC value %u  power %s  pad %s", (unsigned)((pad >> RTC_IO_PDAC1_DAC_S) & 255),
           (pad & RTC_IO_PDAC1_XPD_DAC) ? "on" : "OFF", (pad & RTC_IO_PDAC1_MUX_SEL) ? "analog" : "DIGITAL");
  stLine(y, (pad & RTC_IO_PDAC1_XPD_DAC) ? C_INK : E_CORAL, b);
  Serial.printf("sound test: %s (pad reg %08lX)\n", b, (unsigned long)pad);
  snprintf(b, sizeof b, "DMA control %s   wave generator %s", (c1 & SENS_DAC_DIG_FORCE) ? "ON (stuck!)" : "off",
           (c2 & SENS_DAC_CW_EN1) ? "ON (stuck!)" : "off");
  stLine(y + 12, ((c1 & SENS_DAC_DIG_FORCE) || (c2 & SENS_DAC_CW_EN1)) ? E_CORAL : C_INK, b);
  Serial.printf("sound test: %s (ctrl1 %08lX ctrl2 %08lX)\n", b, (unsigned long)c1, (unsigned long)c2);
}
void soundTestUI() {
  uint16_t acc = appAccent(APP_SETTINGS);
  stopSound(); tgStop();
  if (sndAttached) { ledcDetach(BUZZER_PIN); sndAttached = false; }
  if (P.sndOut) spkWake();                           // (4.1.4) the test starts from mid-level, as it expects
  tft.fillScreen(C_LCD);
  drawTitleBar(FS("Sound test"), acc);
  char b[64];
  snprintf(b, sizeof b, "Sound out: %s   Sound: %s, volume %s", P.sndOut ? "speaker" : "piezo amp", P.sound ? "on" : "OFF",
           P.volume == 0 ? "high" : P.volume == 1 ? "mid" : "low");
  stLine(24, P.sound ? C_INK : E_CORAL, b);
  Serial.printf("sound test: %s\n", b);
  bool ok = dacWrite(BUZZER_PIN, 128);               // the DAC on, at mid-level (1.65 V)
  snprintf(b, sizeof b, "dacWrite(D25, 128): %s", ok ? "ok" : "FAILED");
  stLine(40, ok ? C_INK : E_CORAL, b);
  Serial.printf("sound test: %s\n", b);
  stState(52);
  bool stuck = (READ_PERI_REG(SENS_SAR_DAC_CTRL1_REG) & SENS_DAC_DIG_FORCE) || (READ_PERI_REG(SENS_SAR_DAC_CTRL2_REG) & SENS_DAC_CW_EN1);
  if (stuck) {                                       // (a DMA / wave-generator setting left on would hide every write)
    CLEAR_PERI_REG_MASK(SENS_SAR_DAC_CTRL1_REG, SENS_DAC_DIG_FORCE);
    CLEAR_PERI_REG_MASK(SENS_SAR_DAC_CTRL2_REG, SENS_DAC_CW_EN1);
    stLine(76, E_MINT, "(switched those off now)");
  }
  stLine(92, C_MID, "Multimeter now, D25 to GND: about 1.6 V");
  stLine(104, C_MID, "= the DAC is on. 0 V = it isn't.");
  stLine(124, C_INK, "Then: a 440 Hz tone, made 4 ways.");
  stLine(136, C_INK, "Remember which ones you hear!");
  stLine(222, C_MID, "press: start the tones   hold: back");
  int k;
  while (!(k = stKey())) delay(5);
  static const char* const NAME[4] = {"1: DAC, Arduino's dacWrite()", "2: DAC, register writes (Music, web)",
                                      "3: DAC, 16 kHz timer (the beeps)", "4: PWM square wave (the old way)"};
  for (int t = 0; t < 4 && k != 2; t++) {
    tft.fillRect(0, TITLE_H, W, H - TITLE_H, C_LCD);
    snprintf(b, sizeof b, "Test %s", NAME[t]);
    stLine(30, acc, b);
    stLine(50, C_INK, "playing a 440 Hz tone...");
    stLine(222, C_MID, "press: next test   hold: stop");
    Serial.printf("sound test: playing %s\n", NAME[t]);
    k = 0;
    if (t < 2) {                                     // a square wave by hand, 1136 us per half (= 440 Hz)
      uint32_t at = micros(), n = 0;
      bool hi = false;
      while (!k) {
        while (micros() - at < 1136) {}
        at += 1136; hi = !hi;
        uint8_t v = hi ? 188 : 68;
        if (t == 0) dacWrite(BUZZER_PIN, v);
        else SET_PERI_REG_BITS(RTC_IO_PAD_DAC1_REG, RTC_IO_PDAC1_DAC, v, RTC_IO_PDAC1_DAC_S);
        if ((++n & 31) == 0) { k = stKey(); yield(); }
      }
      dacWrite(BUZZER_PIN, 128);
    } else if (t == 2) {
      bool was = spkReady;
      spkReady = true;                               // (the DAC is already on: no slow rise needed here)
      tgTone(440, 110);
      stState(70);
      while (!(k = stKey())) delay(5);
      tgStop();
      spkReady = was;
    } else {
      ledcAttach(BUZZER_PIN, 440, 8);
      ledcWrite(BUZZER_PIN, 128);
      while (!(k = stKey())) delay(5);
      ledcDetach(BUZZER_PIN);
      dacWrite(BUZZER_PIN, 128);                     // (the DAC back on for the speaker)
    }
  }
  tft.fillRect(0, TITLE_H, W, H - TITLE_H, C_LCD);
  stLine(30, acc, "Which tests did you hear (1-4)?");
  stLine(44, C_INK, "Tell Claude the numbers, and the");
  stLine(56, C_INK, "multimeter reading if you have one.");
  stState(80);
  stLine(222, C_MID, "press: back to Settings");
  while (!stKey()) delay(5);
  if (P.sndOut) { spkReady = true; SET_PERI_REG_BITS(RTC_IO_PAD_DAC1_REG, RTC_IO_PDAC1_DAC, 128, RTC_IO_PDAC1_DAC_S); }
  else { dacDisable(BUZZER_PIN); pinMode(BUZZER_PIN, OUTPUT); digitalWrite(BUZZER_PIN, LOW); spkReady = false; }
  takeClicks(); fPress = fShort = fLong = false;
}
// ---------- Settings > BLUETOOTH > MIDI monitor: what the keyboard sends, live ----------
void mdKeys() {                                      // 5 octaves, C1..C6; lit = held down (< > = held outside them)
  const uint16_t acc = E_MINT;
  const int x0 = 16, y = 38, wk = 8;
  int wi = 0;
  for (int n = 24; n <= 84; n++) {
    if (hrIsBlack(n)) continue;
    int x = x0 + wi * wk;
    tft.fillRect(x, y, wk - 1, 40, mdHeld[n] ? acc : E_WHITE);
    tft.drawFastVLine(x + wk - 1, y, 40, E_RULE);
    if (n % 12 == 0) { char b[4]; snprintf_P(b, sizeof b, PSTR("C%d"), n / 12 - 1); putText(x, 80, 1, C_MID, C_LCD, b); }
    wi++;
  }
  wi = 0;
  for (int n = 24; n <= 84; n++) {
    if (!hrIsBlack(n)) { wi++; continue; }
    tft.fillRect(x0 + wi * wk - 3, y, 5, 24, mdHeld[n] ? acc : C_INK);
  }
  bool lo = false, hi = false;
  for (int n = 0; n < 24; n++) if (mdHeld[n]) lo = true;
  for (int n = 85; n < 128; n++) if (mdHeld[n]) hi = true;
  putText(4, y + 16, 1, lo ? acc : C_GHOST, C_LCD, FS("<"));
  putText(W - 10, y + 16, 1, hi ? acc : C_GHOST, C_LCD, FS(">"));
}
void mdWheels() {
  uint16_t acc = appAccent(APP_SETTINGS);
  int y = 92;
  tft.fillRect(0, y, W, 11, C_LCD);
  putText(4, y + 2, 1, C_MID, C_LCD, FS("BEND"));
  tft.drawRect(32, y, 90, 10, E_RULE);
