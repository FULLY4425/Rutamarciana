      char b[24]; snprintf_P(b, sizeof b, PSTR("x %+d  y %+d"), lx, ly);
      oled.setCursor(64 - (int)strlen(b) * 3, 48); oled.print(b);
      oled.display();
      tft.fillRect(6, 130, W - 12, 20, C_LCD);
      putText(6, 132, 2, acc, C_LCD, b);
    }
    updateButton();
    int c = takeClicks() * ENC_DIR;
