HrSong* HS = nullptr;                                 // the song (malloc'd while the app is open)
portMUX_TYPE hrPoolMux = portMUX_INITIALIZER_UNLOCKED;  // (4.3) the note pool shifts under it; the engine reads notes under it
volatile uint8_t hrGen[HR_SLOTS];                     // bumped when a machine's knobs change: the engine reads them again
QueueHandle_t hrQ = nullptr;                          // screen -> engine: play, stop, notes to hear
