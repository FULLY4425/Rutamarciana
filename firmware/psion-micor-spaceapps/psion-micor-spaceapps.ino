    if (al) { zwP(PSTR(" applyAlignment=\"1\"><alignment horizontal=\"")); zwP(al == 1 ? PSTR("left") : al == 2 ? PSTR("center") : PSTR("right")); zwP(PSTR("\"/></xf>")); }
