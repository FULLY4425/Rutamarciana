void mdStatus() {
  char b[56];
  if (!P.btOn) strcpy_P(b, PSTR("Bluetooth is off (Settings > Bluetooth)"));
  else if (!P.btName[0]) strcpy_P(b, PSTR("nothing paired: Pair a device... first"));
  else snprintf_P(b, sizeof b, PSTR("%.18s: %s"), P.btName, btConnected ? (btMidi ? "connected, MIDI" : "connected, not MIDI") : "connecting...");
  tft.fillRect(0, 21, W, 12, C_LCD);
  putText(4, 23, 1, (btConnected && btMidi) ? E_MINT : C_INK, C_LCD, b);
}
void mdRawLine() {                                   // the last packet as it came (hex) + counters
  char b[64];
  int n = snprintf_P(b, sizeof b, PSTR("raw"));
  int k = mdRawN > 6 ? 6 : mdRawN;
  for (int i = 0; i < k; i++) n += snprintf_P(b + n, sizeof b - n, PSTR(" %02X"), mdRaw[i]);
  if (mdRawN > 6) n += snprintf_P(b + n, sizeof b - n, PSTR(".."));
  snprintf_P(b + n, sizeof b - n, PSTR("  pk %lu clk %lu lost %lu"), (unsigned long)(mdPackets % 100000), (unsigned long)(mdClock % 10000), (unsigned long)(mdLost % 1000));
  tft.fillRect(0, 215, W, 10, C_LCD);
  putText(4, 216, 1, C_MID, C_LCD, b);
}
void midiMonitorUI() {                               // press or hold: back to Settings
  tft.fillScreen(C_LCD);
  drawTitleBar(FS("MIDI monitor"), appAccent(APP_SETTINGS));
  putText(4, 228, 1, C_MID, C_LCD, FS("press or hold: back   (sound: in Music)"));
  mdChanged = true;
  mdStatus(); mdRawLine();
  uint32_t stAt = millis(), pk = mdPackets;
  for (;;) {
    uint32_t now = millis();
    updateButton();
    takeClicks(); takePress();
    if (takeShort() || fLong) break;
    btService(now);
    if (mdChanged) { mdChanged = false; mdKeys(); mdWheels(); mdLogDraw(); }
    if (mdPackets != pk) { pk = mdPackets; mdRawLine(); }
    if (now - stAt > 500) { stAt = now; mdStatus(); mdRawLine(); }
    delay(4);
  }
  takeClicks(); fPress = fShort = fLong = false;
}
