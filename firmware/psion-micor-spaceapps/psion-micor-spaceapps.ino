// ---------- the engine (runs on core 0) ----------
struct HrVoice {
  float f, ft, ph[7], env, fenv, menv, s1, s2, s3, aux, aux2, tmr;
  uint32_t u0, lfsr, age;
  int32_t hold;                                     // a note you hear while editing: samples until it lets go
  uint8_t key, vel, acc, slide, gate, est, left, due, arp;   // est: envelope stage 0 off, 1 attack, 2 decay/sustain, 3 release
  uint8_t live, sus;                                // live: a key held on the MIDI keyboard; sus: let go, but the pedal is down
};
struct HrDrum { float t, env, ph, aux, amp, hp, xp; uint32_t lfsr; uint8_t on; };
struct HrEng {
  HrVoice v[HR_SLOTS][HR_VOX];
  HrDrum dr[HR_SLOTS][8];
  float k[HR_SLOTS][24];                            // each machine's knobs, worked out into coefficients
  uint8_t gen[HR_SLOTS], holdN[HR_SLOTS], pos[HR_SLOTS], patNow[HR_SLOTS];
  float lastF[HR_SLOTS], lfo[HR_SLOTS], lfoR[HR_SLOTS], held[HR_SLOTS], peak[HR_SLOTS];
  float bendMul[HR_SLOTS], modAmt[HR_SLOTS], pmul[HR_SLOTS], vibPh;   // MIDI pitch bend, mod wheel -> each machine's pitch
  uint8_t susOn[HR_SLOTS];
  float T[1024], midi[128], gT[130], sendB[128];
  int16_t* dly[2]; uint16_t dlyW; uint8_t dlyOdd; float dlyLp, dlyAcc;   // (two pieces: easier to find in a full RAM)
  int16_t& dAt(uint16_t i) { i &= HR_DLY - 1; return dly[i >> 12][i & 4095]; }
  bool play, song; uint32_t gStep, secStep; int sec; float stepLeft;
  uint32_t clock, idle, rnd;
  float park, i1, i2, prev, yq, hpX, hpY;           // hpX / hpY: the speaker's bass cut
  uint32_t blocks; uint8_t oPk;                     // (the Serial heartbeat: blocks made, loudest output)
  uint8_t mode;                                     // 0 piezo amp (1-bit, DMA), 1 speaker / AUX (8-bit), 2 piezo amp (PWM, timer)
  // (4.1.4) for recording: a metronome + a count-in, and the speaker's quiet rest
  uint32_t gAll;                                    // steps since PLAY, count-in included (the recording's clock)
  uint16_t pre, preLen;                             // count-in steps still to come / how many it had
  uint8_t metroOn, testOnly;                        // clicks on the beats; the delay test (clicks only, no song)
  int16_t mStart; uint8_t mAcc; float mEnv, mPh, mInc;   // the click: where it starts in this block, accent, its sound
  int curI;                                         // (where in this block the step being started falls)
  float rest;                                       // speaker: 1 = resting at mid-level, 0 = parked at 0 V (no hum)
  bool holdStart;                                   // PLAY while parked: the glide up first, then the first step

  void init() {
    for (int i = 0; i < 1024; i++) T[i] = sinf(i * (6.2831853f / 1024.f));
    for (int i = 0; i < 128; i++) midi[i] = 440.f * powf(2.f, (i - 69) / 12.f);
    for (int i = 0; i < 130; i++) { float c = (i > 128 ? 128 : i) / 128.f; gT[i] = tanf(3.14159265f * 25.f * powf(2.f, c * 8.5f) / HR_SR); }
    rnd = 0x2545F491u; yq = 1.f;
    for (int s = 0; s < HR_SLOTS; s++) {
      gen[s] = (uint8_t)(hrGen[s] + 1);             // (worked out on the first block)
      lfoR[s] = 0.7f; patNow[s] = 255; bendMul[s] = pmul[s] = 1.f;
      for (int i = 0; i < HR_VOX; i++) v[s][i].lfsr = 0x5A5Au + s * 31 + i * 7;
      for (int i = 0; i < 8; i++) dr[s][i].lfsr = 0x4A5Bu + s * 13 + i * 77;
    }
  }
  // ---- little tools ----
  float frand() { rnd ^= rnd << 13; rnd ^= rnd >> 17; rnd ^= rnd << 5; return (int32_t)rnd * (1.f / 2147483648.f); }
  float gOf(float c) {                              // filter cutoff 0..1 (25 Hz .. 9 kHz, log) -> the filter's g
    if (c < 0.f) c = 0.f; if (c > 1.f) c = 1.f;
    float x = c * 128.f; int i = (int)x;
    return gT[i] + (gT[i + 1] - gT[i]) * (x - i);
  }
  static float sat(float x) { if (x > 3.f) x = 3.f; else if (x < -3.f) x = -3.f; return x * (27.f + x * x) / (27.f + 9.f * x * x); }
  static float tc(float sec) { return 1.f - expf(-1.f / (sec * HR_SR)); }          // per-sample glide toward a target
  static float tm(int p) { float x = p * 0.01f; return 0.0015f + 4.f * x * x * x; }  // knob 0..100 -> 1.5 ms .. 4 s
  static float volGain(int v) { float x = v * 0.01f; return x * x * 1.4f; }
  float env(HrVoice& w, float a, float d, float s, float r) {
    switch (w.est) {
      case 1: w.env += (1.3f - w.env) * a; if (w.env >= 1.f) { w.env = 1.f; w.est = 2; } break;
      case 2: w.env += (s - w.env) * d; break;
      case 3: w.env -= w.env * r; if (w.env < 0.0004f) { w.env = 0.f; w.est = 0; } break;
    }
    return w.env;
  }
  void release(HrVoice& w) { w.gate = 0; w.hold = 0; if (w.est == 1 || w.est == 2) w.est = 3; }
  float blep(float t, float dt, float idt) {        // band-limited step: the saw's jump without the fizz
    if (t < dt) { t *= idt; return t + t - t * t - 1.f; }
    if (t > 1.f - dt) { t = (t - 1.f) * idt; return t * t + t + t + 1.f; }
    return 0.f;
  }
  float osc(int w, float& t, float dt, float idt) { // 0 saw, 1 square, 2 triangle
    t += dt; if (t >= 1.f) t -= 1.f;
    if (w == 2) return 4.f * fabsf(t - 0.5f) - 1.f;
    if (w == 0) return t + t - 1.f - blep(t, dt, idt);
    float t2 = t + 0.5f; if (t2 >= 1.f) t2 -= 1.f;
    return (t < 0.5f ? 1.f : -1.f) + blep(t, dt, idt) - blep(t2, dt, idt);
  }
  float lfsr(HrDrum& d, bool metal) {               // the 8-bit noise: a 15-bit shift register (short loop = metallic)
    uint32_t l = d.lfsr, b = (l ^ (l >> (metal ? 6 : 1))) & 1;
    l = (l >> 1) | (b << 14); d.lfsr = l;
    return (l & 1) ? 1.f : -1.f;
  }
  float hp(HrDrum& d, float x, float a) { float y = a * (d.hp + x - d.xp); d.xp = x; d.hp = y; return y; }

  // ---- knobs -> numbers the sound loops use ----
  void derive(int s) {
    gen[s] = hrGen[s];
    HrMach& m = HS->m[s];
    const uint8_t* p = m.prm;
    float* K = k[s];
    switch (m.type) {
      case MT_PAW: {
        K[0] = powf(2.f, (p[0] - 12) / 12.f);
        float ds = 0.25f + 1.75f * powf(p[1] * 0.01f, 1.5f);
        K[1] = p[2] * 0.01f;
        K[2] = 0.55f + 0.42f * p[3] * 0.01f;
        K[3] = (float)(1 << (7 - (p[4] > 6 ? 6 : p[4])));          // levels per side: 8 bit = 128 .. 2 bit = 2
        K[4] = 1 + (p[5] & 7);                                     // each value held this many samples
        static const float TAU[8] = {0.32f, 0.13f, 0.12f, 0.035f, 0.30f, 0.24f, 0.13f, 0.95f};
        for (int i = 0; i < 8; i++) K[8 + i] = expf(-1.f / (TAU[i] * ds * HR_SR));
        break;
      }
      case MT_GLACIER: {
        float det = p[0] * 0.01f; K[0] = det * det;
        float mx = p[1] * 0.01f, cg = 1.f - 0.55f * mx, sg = 0.85f * mx, nrm = 0.42f / sqrtf(cg * cg + 6.f * sg * sg);
        K[1] = cg * nrm; K[2] = sg * nrm;
        K[3] = p[2] * 0.01f; K[4] = 2.f - 1.9f * p[3] * 0.01f;
        K[5] = tc(tm(p[4]) * 0.4f); K[6] = tc(tm(p[5])); K[7] = p[6] * 0.01f; K[8] = tc(tm(p[7]));
        K[9] = p[8] * 0.006f; K[10] = powf(2.f, p[9] - 2);
        K[11] = expf(-1.f / (tm(p[5]) * HR_SR));
        break;
      }
      case MT_FANG: {
        K[0] = p[0]; K[1] = powf(2.f, (p[1] - 12) / 12.f);
        K[2] = 0.08f + 0.6f * p[2] * 0.01f; K[3] = 2.f - 1.95f * p[3] * 0.01f; K[4] = p[4] * 0.0065f;
        float dT = 0.06f + 1.2f * powf(p[5] * 0.01f, 2.f);
        K[5] = expf(-1.f / (dT * HR_SR)); K[10] = expf(-1.f / (dT * 0.45f * HR_SR));
        K[6] = p[6] * 0.01f;
        K[7] = 1.f + p[7] * 0.04f; K[8] = 1.f / (1.f + p[7] * 0.02f);
        K[9] = 1.f / ((0.012f + 0.18f * p[8] * 0.01f) * HR_SR);
        K[11] = tc(0.003f); K[12] = tc(0.012f);
        break;
      }
      case MT_LUNA: {
        float sum = 0.f;
        for (int i = 0; i < 7; i++) { K[i] = p[i] / 8.f; sum += K[i]; }
        float nrm = 0.3f / (0.6f + sum * 0.25f);
        for (int i = 0; i < 7; i++) K[i] *= nrm;
        K[7] = p[7] ? 1.6f * nrm : 0.f; K[8] = p[7] == 2 ? 6.f : 4.f;
        K[9] = expf(-1.f / ((0.08f + 0.9f * p[8] * 0.01f) * HR_SR));
        K[10] = p[9] * 0.005f;
        K[11] = p[10] == 2 ? 6.6f : p[10] == 1 ? 0.75f : 0.f;
        K[12] = 1.f + p[11] * 0.05f; K[13] = 1.f / (1.f + p[11] * 0.03f);
        K[14] = powf(2.f, p[12] - 2);
        K[15] = tc(0.004f + tm(p[13]) * 0.5f); K[16] = tc(0.002f);
        break;
      }
      case MT_DEN: {
        K[0] = p[0]; K[1] = p[1];
        K[2] = powf(2.f, (p[2] - 12) / 12.f) * powf(2.f, p[3] * 0.003f / 12.f);
        float mx = p[4] * 0.01f; K[3] = 1.f - mx; K[4] = mx; K[5] = p[5] * 0.009f;
        K[6] = p[6] * 0.01f; K[7] = 2.f - 1.9f * p[7] * 0.01f; K[8] = p[8] * 0.007f;
        K[9] = expf(-1.f / (tm(p[9]) * HR_SR));
        K[10] = tc(tm(p[10]) * 0.4f); K[11] = tc(tm(p[11])); K[12] = p[12] * 0.01f; K[13] = tc(tm(p[13]));
        K[14] = p[14] ? 1.f / ((0.01f + 0.5f * powf(p[14] * 0.01f, 2.f)) * HR_SR) : 0.f;
        K[15] = powf(2.f, p[15] - 2); K[16] = 0.38f;
        break;
      }
      case MT_BLIP: {
        K[0] = p[0]; K[1] = p[1]; K[2] = (0.012f + 0.13f * (1.f - p[2] * 0.01f)) * HR_SR;
        K[3] = p[3] * 0.006f; K[4] = (p[4] - 12) * 4.f;
        K[5] = tc(tm(p[5]) * 0.4f); K[6] = tc(tm(p[6])); K[7] = p[7] * 0.01f; K[8] = tc(tm(p[8]));
        K[9] = (p[9] - 2) * 12.f;
        break;
      }
      case MT_SPARK: {
        static const float RAT[15] = {0.5f, 1, 1.5f, 2, 2.5f, 3, 3.5f, 4, 5, 6, 7, 8, 9, 11, 14};
        K[0] = RAT[p[0] > 14 ? 14 : p[0]] * (1.f + (p[10] - 50) * 0.0004f);
        K[1] = p[1] * 0.0125f; K[2] = tc(tm(p[2])); K[3] = p[3] * 0.01f; K[4] = p[4] * 0.0035f;
        K[5] = tc(tm(p[5]) * 0.4f); K[6] = tc(tm(p[6])); K[7] = p[7] * 0.01f; K[8] = tc(tm(p[8]));
        K[9] = powf(2.f, p[9] - 2);
        break;
      }
    }
  }

  // ---- notes ----
  void drumHit(int s, int lane, int vel, int acc) {
    HrDrum& d = dr[s][lane & 7];
    d.t = 0.f; d.env = 1.f; d.aux = 1.f; d.ph = 0.f; d.hp = d.xp = 0.f; d.on = 1;
    d.amp = vel / 15.f * (acc ? 1.35f : 1.f);
    if (!d.lfsr) d.lfsr = 0x4A5Bu + lane * 77;
    if ((lane & 7) == 3) dr[s][4].on = 0;                          // a closed hat chokes the open one
  }
  HrVoice* noteOn(int s, int key, int vel, int fx, int len, int32_t hold) {
    HrMach& m = HS->m[s];
    if (vel <= 0) vel = 12;
    if (m.type == MT_PAW) { drumHit(s, key, vel, fx & 1); return nullptr; }
    if (m.type == MT_NONE) return nullptr;
    key &= 127;
    float f = midi[key];
    HrVoice* w = nullptr;
    bool legato = false;
    if (m.type == MT_FANG) { w = &v[s][0]; legato = w->gate && w->slide && w->est; }   // one voice; slide = glide, no new attack
    else {
      for (int i = 0; i < HR_VOX && !w; i++) if (v[s][i].gate && v[s][i].key == key) w = &v[s][i];
      for (int i = 0; i < HR_VOX && !w; i++) if (!v[s][i].est) w = &v[s][i];
      if (!w) { float best = 9.f; for (int i = 0; i < HR_VOX; i++) if (!v[s][i].gate && v[s][i].env < best) { best = v[s][i].env; w = &v[s][i]; } }
      if (!w) { uint32_t old = 0xFFFFFFFFu; for (int i = 0; i < HR_VOX; i++) if (v[s][i].age < old) { old = v[s][i].age; w = &v[s][i]; } }
    }
    bool fresh = !w->est;
    if (fresh) { w->env = 0.f; w->s1 = w->s2 = w->s3 = 0.f; }
    w->key = key; w->vel = vel; w->left = len; w->hold = hold; w->due = 0; w->age = clock; w->live = w->sus = 0;
    switch (m.type) {
      case MT_GLACIER:
        if (fresh) for (int j = 0; j < 7; j++) w->ph[j] = frand() * 0.5f + 0.5f;     // free-running saws: never the same twice
        w->f = w->ft = f; w->fenv = 1.f; w->est = 1; break;
      case MT_FANG:
        if (legato) w->ft = f; else { w->f = w->ft = f; w->est = 1; w->fenv = 1.f; }
        w->acc = fx & 1; break;
      case MT_LUNA: {
        bool other = false;                                        // percussion only on the first key (like the real thing)
        for (int i = 0; i < HR_VOX; i++) if (&v[s][i] != w && v[s][i].gate) other = true;
        if (fresh) w->u0 = 0;
        w->f = w->ft = f; w->est = 1; w->aux = other ? 0.f : 1.f; w->aux2 = 1.f; break;
      }
      case MT_DEN:
        w->ft = f; w->f = (k[s][14] > 0.f && lastF[s] > 0.f) ? lastF[s] : f; lastF[s] = f;
        w->ph[0] = w->ph[1] = w->ph[2] = 0.f; w->fenv = 1.f; w->est = 1; break;
      case MT_BLIP:
        w->f = f; w->ph[0] = 0.f; w->arp = 0; w->tmr = k[s][2]; w->aux = 0.f; w->aux2 = 0.f; w->est = 1; break;
      case MT_SPARK:
        w->ph[0] = w->ph[1] = 0.f; w->menv = 1.f; w->aux = 0.f; w->f = f; w->est = 1; break;
    }
    w->slide = (fx >> 1) & 1;
    w->gate = 1;
    return w;
  }
  void allOff(bool hard) {
    for (int s = 0; s < HR_SLOTS; s++) {
      for (int i = 0; i < HR_VOX; i++) { HrVoice& w = v[s][i]; release(w); w.left = 0; w.due = 0; w.live = w.sus = 0; if (hard) { w.est = 0; w.env = 0.f; } }
      if (hard) for (int i = 0; i < 8; i++) dr[s][i].on = 0;
    }
  }
  float stepLen() {                                 // samples in this 16th note (swing: long on-beats, short off-beats)
    float base = HR_SR * 15.f / (HS->bpm < 40 ? 40 : HS->bpm), sw = HS->swing * 0.01f;
    uint32_t ps = song ? secStep : gStep;           // (already counts the step that just started)
    return (ps & 1) ? base * (1.f + sw) : base * (1.f - sw);
  }
  void step() {                                     // one 16th note: every machine looks at its pattern
    HrSong* S = HS;
    if (song) {
      if (S->nsec < 1) { play = false; return; }
      if (sec >= S->nsec) sec = 0;
      if (secStep >= (uint32_t)(S->sec[sec].len ? S->sec[sec].len : 16)) {
        secStep = 0;
        if (++sec >= S->nsec) { sec = 0; if (!S->loop) { play = false; allOff(false); return; } }
      }
    }
    bool solo = false;
    for (int s = 0; s < HR_SLOTS; s++) if (S->m[s].solo && S->m[s].type) solo = true;
    for (int s = 0; s < HR_SLOTS; s++) {
      HrMach& m = S->m[s];
      if (!m.type) { patNow[s] = 255; continue; }
      for (int q = 0; q < HR_VOX; q++) { HrVoice& w = v[s][q]; if (w.left && --w.left == 0) w.due = 1; }
      int p = song ? S->sec[sec].pat[s] : m.cur;
      patNow[s] = p < HR_PATS ? p : 255;
      if (p < HR_PATS) {
        HrPat& pt = m.pat[p];
        int len = pt.len < 1 ? 16 : pt.len > HR_STEPS ? HR_STEPS : pt.len;
        uint32_t at = (song ? secStep : gStep) % len;      // each machine loops its own length
        pos[s] = at;
        if (!(m.mute || (solo && !m.solo))) {
          HrNote hit[24]; int nh = 0;                    // (4.3) the notes on this step, copied out under the pool's lock
          portENTER_CRITICAL(&hrPoolMux);
          int o = pt.off, nn = pt.n > HR_NOTES ? HR_NOTES : pt.n;
          if (o > HR_POOL) o = HR_POOL; if (o + nn > HR_POOL) nn = HR_POOL - o;
          HrNote* PN = S->pool + o;
          for (int q = 0; q < nn; q++) {
            HrNote& N = PN[q];
            if (N.at != at) continue;
            if (N.fx & 4) { N.fx &= ~4; continue; }      // (4.1.4) just recorded, and you heard it live: not again this time
            if (nh < 24) hit[nh++] = N;
          }
          portEXIT_CRITICAL(&hrPoolMux);
          for (int q = 0; q < nh; q++) noteOn(s, hit[q].key, hit[q].fx >> 4, hit[q].fx, hit[q].len ? hit[q].len : 1, 0);
        }
      }
      for (int q = 0; q < HR_VOX; q++) { HrVoice& w = v[s][q]; if (w.due) { w.due = 0; release(w); } }   // notes that ended
    }
    gStep++; secStep++;
  }
  float tick() {                                    // (4.1.4) one step of the transport: count-in, metronome, the song
    uint32_t k = gAll++;                            // -> how long this step lasts (samples)
    float base = HR_SR * 15.f / (HS->bpm < 40 ? 40 : HS->bpm);
    if (pre) {                                      // the count-in: a bar of clicks, then the song from its first step
      int b = preLen - pre; pre--;
      if ((b & 3) == 0) { mStart = curI; mAcc = b == 0; }
      return base;
    }
    uint32_t sk = k - preLen;
    if ((metroOn || testOnly) && (sk & 3) == 0) { mStart = curI; mAcc = (sk & 15) == 0; }
    if (testOnly) { gStep++; secStep++; return base; }
    step();
    return stepLen();
  }
  static int gmLane(int n) {                        // a MIDI note -> one of PAWBEAT's 8 drums (General MIDI drum keys)
    switch (n) {
      case 35: case 36: return 0;
      case 37: case 38: case 40: return 1;
      case 39: return 2;
      case 42: case 44: return 3;
      case 46: case 51: case 53: case 59: return 4;
      case 41: case 43: case 45: case 47: case 48: case 50: return 5;
      case 54: case 56: case 58: return 6;
      case 49: case 52: case 55: case 57: return 7;
    }
    static const uint8_t BY[12] = {0, 2, 1, 2, 1, 5, 3, 5, 3, 6, 4, 7};   // other keys, by name: C kick, D snare, F# hat...
    return BY[(n & 127) % 12];
  }
  void midiIn(int s, uint8_t st, uint8_t d1, uint8_t d2) {   // a message from the MIDI keyboard, for machine s
    uint8_t t = st & 0xF0;
    if ((st & 15) == 9) for (int q = 0; q < HR_SLOTS; q++) if (HS->m[q].type == MT_PAW) { s = q; break; }   // channel 10 (pads) = drums
    if (s < 0 || s >= HR_SLOTS || !HS->m[s].type) return;
    HrMach& m = HS->m[s];
    if (t == 0x90 && d2) {
      int vel = (d2 * 15 + 63) / 127; if (vel < 1) vel = 1;
      if (m.type == MT_PAW) { drumHit(s, gmLane(d1), vel, d2 >= 115); return; }
      if (m.type == MT_FANG && v[s][0].gate && v[s][0].live) v[s][0].slide = 1;   // overlapping keys on the acid bass = a slide
      HrVoice* w = noteOn(s, d1, vel, 0, 0, 0);
      if (w) w->live = 1;
    } else if (t == 0x80 || t == 0x90) {
      for (int q = 0; q < HR_VOX; q++) {
        HrVoice& w = v[s][q];
        if (w.live && w.gate && w.key == d1) { if (susOn[s]) w.sus = 1; else { w.live = 0; release(w); } }
      }
    } else if (t == 0xB0) {
      if (d1 == 64) {                                // sustain pedal
        susOn[s] = d2 >= 64;
        if (!susOn[s]) for (int q = 0; q < HR_VOX; q++) if (v[s][q].sus) { v[s][q].sus = v[s][q].live = 0; release(v[s][q]); }
      } else if (d1 == 1) modAmt[s] = d2 / 127.f;    // mod wheel = vibrato
      else if (d1 == 120 || d1 == 123) for (int q = 0; q < HR_VOX; q++) if (v[s][q].live) { v[s][q].live = v[s][q].sus = 0; release(v[s][q]); }
    } else if (t == 0xE0) bendMul[s] = powf(2.f, (((int)d2 << 7 | d1) - 8192) * (2.f / 8192.f / 12.f));   // +/- 2 semitones
  }
  void command(const HrCmd& c) {
    switch (c.op) {
      case HC_PLAY: {
        allOff(false); song = c.a; sec = c.b; gStep = secStep = 0; stepLeft = 0.f; if (song && sec >= HS->nsec) sec = 0; play = true;
        testOnly = (c.c >> 1) & 1; gAll = 0; pre = preLen = ((c.c & 1) && !testOnly) ? 16 : 0;   // (4.1.4) count-in / delay test
        holdStart = mode == 1 && rest < 0.999f;      // (parked: the speaker glides up before the first step)
        uint32_t at = 0; if (song) for (int i = 0; i < sec; i++) at += HS->sec[i].len ? HS->sec[i].len : 16;
        uint8_t r = HS->pad[2]; apPh = r ? (float)(at % r) / r : 0.f; ppCnt = 0; ppG = 0.f;   // (the sweep: from the section's place)
        break;
      }
      case HC_STOP: play = false; allOff(false); break;
      case HC_NOTE: if (c.a < HR_SLOTS) noteOn(c.a, c.b, c.c & 15, c.c >> 4, 0, (int32_t)(c.d * (HR_SR / 1000.f))); break;
      case HC_MIDI: midiIn(c.a, c.b, c.c, (uint8_t)c.d); break;
      case HC_RESET:
        if (c.a < HR_SLOTS) {
          for (int q = 0; q < HR_VOX; q++) { HrVoice& w = v[c.a][q]; w.est = 0; w.gate = 0; w.env = 0.f; w.left = 0; w.hold = 0; w.live = w.sus = 0; }
          for (int i = 0; i < 8; i++) dr[c.a][i].on = 0;
          lastF[c.a] = 0.f;
        }
        break;
    }
  }

  // ---- the machines: each adds n samples of its voices to o, says if anything sounded ----
  bool rPaw(int s, float* o, int n) {
    float* K = k[s];
    bool any = false;
    float tune = K[0], punch = K[1], hpa = K[2], q = K[3];
    int hn = (int)K[4];
    const float dts = 1.f / HR_SR;
    for (int ln = 0; ln < 8; ln++) {
      HrDrum& d = dr[s][ln];
      if (!d.on) continue;
      any = true;
      float dc = K[8 + ln], amp = d.amp;
      for (int i = 0; i < n; i++) {
        float x = 0.f;
        switch (ln) {
          case 0: {                                 // kick: a sine diving in pitch + a click
            float f = (46.f + (160.f + 520.f * punch) * d.aux) * tune; d.aux *= 0.9985f;
            d.ph += f * dts; if (d.ph >= 1.f) d.ph -= 1.f;
            x = T[(int)(d.ph * 1024.f) & 1023] * 1.1f;
            if (d.t < 0.004f) x += lfsr(d, false) * 0.3f;
            break;
          }
          case 1: {                                 // snare: a short tone + bright noise
            d.ph += 190.f * tune * dts; if (d.ph >= 1.f) d.ph -= 1.f;
            float tone = T[(int)(d.ph * 1024.f) & 1023] * d.aux; d.aux *= 0.99909f;
            x = tone * 0.55f + hp(d, lfsr(d, false), hpa) * 0.6f;
            break;
          }
          case 2: {                                 // clap: three quick bursts, then the tail
            float e = 1.f;
            if (d.t < 0.024f) { float tt = fmodf(d.t, 0.008f); e = 1.f - tt * 110.f; if (e < 0.f) e = 0.f; }
            x = hp(d, lfsr(d, false), hpa * 0.9f + 0.05f) * e * 0.7f;
            break;
          }
          case 3: case 4: x = hp(d, lfsr(d, true), 0.93f) * 0.4f; break;      // hats: the metallic noise
          case 5: {                                 // tom
            float f = 105.f * tune * (1.f + 0.7f * d.aux); d.aux *= 0.99925f;
            d.ph += f * dts; if (d.ph >= 1.f) d.ph -= 1.f;
            x = T[(int)(d.ph * 1024.f) & 1023];
            break;
          }
          case 6: {                                 // zap: a laser-ish square sweep
            float f = (90.f + 1900.f * d.aux) * tune; d.aux *= 0.9987f;
            d.ph += f * dts; if (d.ph >= 1.f) d.ph -= 1.f;
            x = d.ph < 0.5f ? 0.6f : -0.6f;
            break;
          }
          default: x = hp(d, lfsr(d, false), 0.9f) * 0.35f; break;           // crash
        }
        o[i] += x * d.env * amp;
        d.env *= dc; d.t += dts;
      }
      if (d.env < 0.0005f) d.on = 0;
    }
    if (!any) return false;
    for (int i = 0; i < n; i++) {                   // the 8-bit grit: fewer levels, each held a few samples
      if (++holdN[s] >= hn) { holdN[s] = 0; held[s] = roundf(o[i] * 0.6f * q) / q; }
      o[i] = held[s];
    }
    return true;
  }
  bool rGlacier(int s, float* o, int n) {           // 7 detuned saws per note
    static const float OFF[7] = {-0.11002313f, -0.06288439f, -0.01952356f, 0.f, 0.01991221f, 0.06216538f, 0.10745242f};
    float* K = k[s];
    bool any = false;
    for (int vi = 0; vi < HR_VOX; vi++) {
      HrVoice& w = v[s][vi];
      if (!w.est) continue;
      any = true;
      float base = w.f * K[10] * pmul[s] * (1.f / HR_SR), dt[7], idt[7], gj[7];
      for (int j = 0; j < 7; j++) {
        dt[j] = base * (1.f + K[0] * OFF[j]); if (dt[j] > 0.45f) dt[j] = 0.45f;
        idt[j] = 1.f / dt[j]; gj[j] = j == 3 ? K[1] : K[2];
      }
      float g = gOf(K[3] + K[9] * w.fenv), kk = K[4], a1 = 1.f / (1.f + g * (g + kk)), a2 = g * a1, a3 = g * a2;
      float vel = w.vel * (1.f / 15.f);
      for (int i = 0; i < n; i++) {
        float sum = 0.f;
        for (int j = 0; j < 7; j++) {
          float t = w.ph[j] + dt[j]; if (t >= 1.f) t -= 1.f; w.ph[j] = t;
          float x = t + t - 1.f;
          if (t < dt[j]) { float u = t * idt[j]; x -= u + u - u * u - 1.f; }
          else if (t > 1.f - dt[j]) { float u = (t - 1.f) * idt[j]; x -= u * u + u + u + 1.f; }
          sum += x * gj[j];
        }
        float v3 = sum - w.s2, v1 = a1 * w.s1 + a2 * v3, v2 = w.s2 + a2 * w.s1 + a3 * v3;
        w.s1 = 2.f * v1 - w.s1; w.s2 = 2.f * v2 - w.s2;
        o[i] += v2 * env(w, K[5], K[6], K[7], K[8]) * vel;
        w.fenv *= K[11];
      }
    }
    return any;
  }
  bool rFang(int s, float* o, int n) {              // one saw/square into a squelchy resonant filter
    float* K = k[s];
    HrVoice& w = v[s][0];
    if (!w.est) return false;
    float gl = n * K[9]; if (gl > 1.f) gl = 1.f;
    w.f += (w.ft - w.f) * gl;
    float dt = w.f * K[1] * pmul[s] * (1.f / HR_SR); if (dt > 0.45f) dt = 0.45f;
    float idt = 1.f / dt, acc = w.acc ? K[6] : 0.f;
    float g = gOf(K[2] + K[4] * w.fenv * (1.f + acc) + acc * 0.1f * w.fenv), kk = K[3] * (1.f - 0.35f * acc);
    if (kk < 0.05f) kk = 0.05f;
    float a1 = 1.f / (1.f + g * (g + kk)), a2 = g * a1, a3 = g * a2, G = g / (1.f + g);
    float amp = w.vel * (1.f / 15.f) * (1.f + 0.6f * acc) * 0.9f, fdc = w.acc ? K[10] : K[5];
    int wave = (int)K[0];
    for (int i = 0; i < n; i++) {
      float x = osc(wave, w.ph[0], dt, idt);
      float v3 = x - w.s2, v1 = a1 * w.s1 + a2 * v3, v2 = w.s2 + a2 * w.s1 + a3 * v3;
      w.s1 = 2.f * v1 - w.s1; w.s2 = 2.f * v2 - w.s2;
      float u = (v2 - w.s3) * G, y = u + w.s3; w.s3 = y + u;                  // one more pole: steeper, rounder
      y = sat(y * K[7]) * K[8];
      o[i] += y * env(w, K[11], 0.f, 1.f, K[12]) * amp;
      w.fenv *= fdc;
    }
    return true;
  }
  bool rLuna(int s, float* o, int n) {              // tonewheel-style drawbars: 7 sines on one phase
    static const uint8_t MUL[7] = {1, 2, 3, 4, 6, 8, 16};
    float* K = k[s];
    float tgt = K[11];
    lfoR[s] += (tgt - lfoR[s]) * n * (1.2f / HR_SR);                       // the rotating speaker spins up slowly
    lfo[s] += lfoR[s] * n * (1.f / HR_SR); if (lfo[s] >= 1.f) lfo[s] -= 1.f;
    float ls = T[(int)(lfo[s] * 1024.f) & 1023], on = (tgt > 0.f || lfoR[s] > 0.05f) ? 1.f : 0.f;
    float vib = 1.f + 0.0022f * ls * on, trem = 1.f - 0.18f * on * (0.5f + 0.5f * ls);
    bool any = false;
    for (int vi = 0; vi < HR_VOX; vi++) {
      HrVoice& w = v[s][vi];
      if (!w.est) continue;
      any = true;
      float hz = w.f * K[14] * 0.5f * pmul[s], b[7];
      if (hz > 9000.f) hz = 9000.f;
      uint32_t inc = (uint32_t)(hz * vib * (4294967296.f / HR_SR)), pm = (uint32_t)K[8];
      for (int j = 0; j < 7; j++) b[j] = hz * MUL[j] < 10000.f ? K[j] : 0.f;   // (no drawbar above 10 kHz)
      float pg = K[7], pdc = K[9], ck = K[10], vel = (0.55f + 0.45f * w.vel / 15.f) * trem;
      for (int i = 0; i < n; i++) {
        uint32_t P = (w.u0 += inc);
        float x = b[0] * T[P >> 22] + b[1] * T[(P * 2) >> 22] + b[2] * T[(P * 3) >> 22] + b[3] * T[(P * 4) >> 22]
                + b[4] * T[(P * 6) >> 22] + b[5] * T[(P * 8) >> 22] + b[6] * T[(P * 16) >> 22];
        if (w.aux > 0.001f) { x += pg * w.aux * T[(P * pm) >> 22]; w.aux *= pdc; }
        if (w.aux2 > 0.002f) { x += frand() * w.aux2 * ck; w.aux2 *= 0.92f; }
        o[i] += x * env(w, K[16], 0.f, 1.f, K[15]) * vel;
      }
    }
    if (any && K[12] > 1.01f) for (int i = 0; i < n; i++) o[i] = sat(o[i] * K[12]) * K[13];
    return any;
  }
  bool rDen(int s, float* o, int n) {               // 2 oscillators + a sub octave into a resonant filter
    float* K = k[s];
    int w1 = (int)K[0], w2 = (int)K[1];
    bool any = false;
    for (int vi = 0; vi < HR_VOX; vi++) {
      HrVoice& w = v[s][vi];
      if (!w.est) continue;
      any = true;
      if (K[14] > 0.f) { float gl = n * K[14]; if (gl > 1.f) gl = 1.f; w.f += (w.ft - w.f) * gl; } else w.f = w.ft;
      float dt1 = w.f * K[15] * pmul[s] * (1.f / HR_SR); if (dt1 > 0.45f) dt1 = 0.45f;
      float dt2 = dt1 * K[2]; if (dt2 > 0.45f) dt2 = 0.45f;
      float dts = dt1 * 0.5f, i1 = 1.f / dt1, i2 = 1.f / dt2;
      float g = gOf(K[6] + K[8] * w.fenv), kk = K[7], a1 = 1.f / (1.f + g * (g + kk)), a2 = g * a1, a3 = g * a2;
      float amp = w.vel * (1.f / 15.f) * K[16];
      for (int i = 0; i < n; i++) {
        float x = osc(w1, w.ph[0], dt1, i1) * K[3] + osc(w2, w.ph[1], dt2, i2) * K[4];
        w.ph[2] += dts; if (w.ph[2] >= 1.f) w.ph[2] -= 1.f;
        x += w.ph[2] < 0.5f ? K[5] : -K[5];
        float v3 = x - w.s2, v1 = a1 * w.s1 + a2 * v3, v2 = w.s2 + a2 * w.s1 + a3 * v3;
        w.s1 = 2.f * v1 - w.s1; w.s2 = 2.f * v2 - w.s2;
        o[i] += v2 * env(w, K[10], K[11], K[12], K[13]) * amp;
        w.fenv *= K[9];
      }
    }
    return any;
  }
  bool rBlip(int s, float* o, int n) {              // chip voice: pulses, a 4-bit triangle, noise, fast arpeggios
    static const int8_t ARP[6][4] = {{0, 0, 0, 0}, {0, 12, 0, 12}, {0, 4, 7, 12}, {0, 3, 7, 12}, {0, 7, 12, 7}, {0, 5, 7, 12}};
    float* K = k[s];
    int wave = (int)K[0], am = (int)K[1];
    if (am > 5) am = 5;
    bool any = false;
    for (int vi = 0; vi < HR_VOX; vi++) {
      HrVoice& w = v[s][vi];
      if (!w.est) continue;
      any = true;
      if (am) { w.tmr -= n; if (w.tmr <= 0.f) { w.tmr += K[2]; w.arp = (w.arp + 1) & 3; } }
      w.aux += K[4] * n * (1.f / HR_SR); if (w.aux > 36.f) w.aux = 36.f; else if (w.aux < -36.f) w.aux = -36.f;
      w.aux2 += 5.5f * n * (1.f / HR_SR); if (w.aux2 >= 1.f) w.aux2 -= 1.f;
      float vib = (clock - w.age) > (uint32_t)(HR_SR * 0.15f) ? K[3] * T[(int)(w.aux2 * 1024.f) & 1023] : 0.f;
      float semi = w.key + K[9] + (am ? ARP[am][w.arp] : 0) + w.aux + vib;
      float dt = 440.f * exp2f((semi - 69.f) * (1.f / 12.f)) * pmul[s] * (1.f / HR_SR);
      if (dt > 0.45f) dt = 0.45f;
      float amp = w.vel * (1.f / 15.f) * 0.38f, duty = wave == 0 ? 0.125f : wave == 1 ? 0.25f : 0.5f;
      for (int i = 0; i < n; i++) {
        float t = w.ph[0] + dt; if (t >= 1.f) t -= 1.f; w.ph[0] = t;
        float x;
        if (wave <= 2) x = t < duty ? 1.f : -1.f;
        else if (wave == 3) { float tr = 4.f * fabsf(t - 0.5f) - 1.f; x = (int)((tr + 1.f) * 7.5f) * (2.f / 15.f) - 1.f; }
        else {
          w.ph[1] += dt * 16.f;
          while (w.ph[1] >= 1.f) { w.ph[1] -= 1.f; uint32_t l = w.lfsr; l = (l >> 1) | (((l ^ (l >> 1)) & 1) << 14); w.lfsr = l ? l : 1; }
          x = (w.lfsr & 1) ? 1.f : -1.f;
        }
        float e = env(w, K[5], K[6], K[7], K[8]);
        o[i] += x * (int)(e * 15.f) * (1.f / 15.f) * amp;                  // 16 volume steps, like old consoles
      }
    }
    return any;
  }
  bool rSpark(int s, float* o, int n) {             // 2-operator FM: a modulator bends the carrier's phase
    float* K = k[s];
    bool any = false;
    for (int vi = 0; vi < HR_VOX; vi++) {
      HrVoice& w = v[s][vi];
      if (!w.est) continue;
      any = true;
      float dc = w.f * K[9] * pmul[s] * (1.f / HR_SR); if (dc > 0.45f) dc = 0.45f;
      float dm = dc * K[0]; if (dm > 0.48f) dm = 0.48f;
      float I = K[1] * (0.55f + 0.45f * w.vel / 15.f), fb = K[4], amp = w.vel * (1.f / 15.f) * 0.42f;
      for (int i = 0; i < n; i++) {
        float pm = w.ph[1] + dm; if (pm >= 1.f) pm -= 1.f; w.ph[1] = pm;
        float pc = w.ph[0] + dc; if (pc >= 1.f) pc -= 1.f; w.ph[0] = pc;
        float m = T[(int)((pm + w.aux * fb) * 1024.f) & 1023];
        w.aux = m;
        w.menv += (K[3] - w.menv) * K[2];
        float x = T[(int)((pc + m * I * w.menv) * 1024.f) & 1023];
        o[i] += x * env(w, K[5], K[6], K[7], K[8]) * amp;
      }
    }
    return any;
  }
  bool slot(int s, int t, float* o, int n) {
    switch (t) {
      case MT_PAW: return rPaw(s, o, n);
      case MT_GLACIER: return rGlacier(s, o, n);
      case MT_FANG: return rFang(s, o, n);
      case MT_LUNA: return rLuna(s, o, n);
      case MT_DEN: return rDen(s, o, n);
      case MT_BLIP: return rBlip(s, o, n);
      case MT_SPARK: return rSpark(s, o, n);
    }
    return false;
  }

  // ---- one block: commands, the sequencer (to the sample), the machines, the mixer, the echo ----
  // ---- stereo (4.1; the .howl's spare bytes, the same as HOWL RACK for PC 4.1 - all zero = the old mono sound):
  //   machine pad byte = PAN, signed -64 left .. 0 centre .. +64 right; header pad[0] bit 0 = PING-PONG echo;
  //   header pad[1] = AUTO-PAN (a bit per machine), pad[2] = steps per sweep (0 = off; odd machines sweep the other way)
  float gL[HR_SLOTS], gR[HR_SLOTS], apPh, ppG, hpXR, hpYR; uint32_t ppCnt;
  static float panOf(uint8_t b) { int v = (int8_t)b; return (v < -64 ? -64 : v > 64 ? 64 : v) / 64.f; }
  bool render(float* out, float* outR, int n) {          // left in out, right in outR
    HrCmd c;
    while (hrQ && xQueueReceive(hrQ, &c, 0) == pdTRUE) command(c);
    HrSong* S = HS;
    for (int s = 0; s < HR_SLOTS; s++) if (gen[s] != hrGen[s]) derive(s);
    for (int i = 0; i < n; i++) out[i] = outR[i] = sendB[i] = 0.f;
    metroOn = hrMetroWant; mStart = -1;              // (4.1.4) the metronome follows the setting + the MIDI keys mode
    if (holdStart && rest >= 0.999f) holdStart = false;
    uint8_t apMask = S->pad[2] ? (S->pad[1] & 0x7F) : 0;
    float apInc = S->pad[2] ? 1.f / (HR_SR * 15.f / (S->bpm < 40 ? 40 : S->bpm) * S->pad[2]) : 0.f;
    bool solo = false, busy = play;
    float pk[HR_SLOTS];
    for (int s = 0; s < HR_SLOTS; s++) { pk[s] = 0.f; if (S->m[s].solo && S->m[s].type) solo = true; }
    int i = 0;
    while (i < n) {
      bool run = play && !holdStart;
      curI = i;
      while (play && !holdStart && stepLeft <= 0.f) stepLeft += tick();   // (4.1.4: count-in + metronome + the song)
      int cn = n - i; if (cn > 16) cn = 16;
      if (run && play) { int sl = (int)ceilf(stepLeft); if (sl < 1) sl = 1; if (sl < cn) cn = sl; }   // stop right at the next step
      vibPh += 5.5f * cn / HR_SR; if (vibPh >= 1.f) vibPh -= 1.f;
      float vs = T[(int)(vibPh * 1024.f) & 1023];
      for (int s = 0; s < HR_SLOTS; s++) pmul[s] = bendMul[s] * (1.f + modAmt[s] * 0.02f * vs);
      float sw = apMask ? T[(int)(apPh * 1024.f) & 1023] * 0.9f : 0.f;   // the auto-pan sweep
      apPh += apInc * cn; if (apPh >= 1.f) apPh -= (int)apPh;
      for (int s = 0; s < HR_SLOTS; s++) {                            // balance law: centre = full level on both sides
        float p = panOf(S->m[s].pad);
        if (apMask >> s & 1) p += (s & 1) ? -sw : sw;
        p = p < -1.f ? -1.f : p > 1.f ? 1.f : p;
        gL[s] = p > 0.f ? 1.f - p : 1.f; gR[s] = p < 0.f ? 1.f + p : 1.f;
      }
      for (int s = 0; s < HR_SLOTS; s++) {
        HrMach& m = S->m[s];
        if (!m.type) continue;
        float tmp[16];
        for (int j = 0; j < cn; j++) tmp[j] = 0.f;
        if (!slot(s, m.type, tmp, cn)) continue;
        busy = true;
        float g = (m.mute || (solo && !m.solo)) ? 0.f : volGain(m.vol), sd = g * m.send * 0.01f;
        for (int j = 0; j < cn; j++) {
          float x = tmp[j] * g, a = fabsf(x);
          if (a > pk[s]) pk[s] = a;
          out[i + j] += x * gL[s]; outR[i + j] += x * gR[s]; sendB[i + j] += tmp[j] * sd;
        }
      }
      for (int s = 0; s < HR_SLOTS; s++) for (int q = 0; q < HR_VOX; q++) {
        HrVoice& w = v[s][q];
        if (w.hold > 0 && (w.hold -= cn) <= 0) release(w);
      }
      if (play && !holdStart) stepLeft -= cn;
      clock += cn; i += cn;
    }
    for (int s = 0; s < HR_SLOTS; s++) peak[s] = pk[s];
    static const float DM[5] = {1.f, 2.f, 3.f, 4.f, 6.f};          // echo: 1/16, 1/8, 3/16, 1/4, 3/8
    int D = (int)(HR_SR * 15.f / (S->bpm < 40 ? 40 : S->bpm) * DM[S->dlyTime % 5]);
    if (D > 2 * HR_DLY - 4) D = 2 * HR_DLY - 4; if (D < 4) D = 4;
    // speaker: 2.4 x louder into the soft limiter, and the deep bass a small speaker can't play (under ~90 Hz)
    // taken out first, so it doesn't use up the 8-bit DAC's room
    bool spk = mode == 1;
    float fb = S->dlyFb * 0.0085f, wet = S->dlyMix * 0.01f, mg = S->master * S->master * 0.000125f * (spk ? 2.4f : 1.f);
    static const float VOLS[2][3] = {{1.f, 0.5f, 0.25f}, {1.f, 0.6f, 0.35f}};
    float vol = P.sound ? VOLS[spk][P.volume % 3] : 0.f;
    bool ping = S->pad[0] & 1;
    uint32_t D2 = 2u * (uint32_t)D;
    for (int j = 0; j < n; j++) {
      float x = out[j], xr = outR[j];
      if (dly[0] && dly[1]) {                       // the echo memory runs at half rate: D samples back = D / 2 in it
        uint32_t pp = ((uint32_t)dlyW * 2 + dlyOdd - D) & (2 * HR_DLY - 1);
        uint16_t k = pp >> 1;
        float tap = (pp & 1) ? (dAt(k) + dAt(k + 1)) * (0.5f / 8192.f) : dAt(k) * (1.f / 8192.f);
        dlyLp += (tap - dlyLp) * 0.45f;                            // darker repeats
        float w = sendB[j] + dlyLp * fb;
        w = w > 3.9f ? 3.9f : w < -3.9f ? -3.9f : w;
        if (dlyOdd) { dAt(dlyW) = (int16_t)((dlyAcc + w) * 4096.f); dlyW = (dlyW + 1) & (HR_DLY - 1); dlyOdd = 0; }
        else { dlyAcc = w; dlyOdd = 1; }
        if (ping) {                                  // ping-pong: the echo's side flips every echo time (no extra RAM)
          if (++ppCnt >= D2) ppCnt %= D2;
          ppG += ((ppCnt >= (uint32_t)D ? 1.f : 0.f) - ppG) * 0.004f;
          x += tap * wet * (1.f - ppG); xr += tap * wet * ppG;
        } else { x += tap * wet; xr += tap * wet; }
        if (tap > 0.002f || tap < -0.002f) busy = true;
      }
      if (spk) {
        float y = 0.9755f * (hpY + x - hpX); hpX = x; hpY = y; x = y;
        float yr = 0.9755f * (hpYR + xr - hpXR); hpXR = xr; hpYR = yr; xr = yr;
      }
      out[j] = sat(x * mg) * vol; outR[j] = sat(xr * mg) * vol;
      if (j == mStart) { mEnv = 1.f; mPh = 0.f; mInc = (mAcc ? 2400.f : 1600.f) / HR_SR; }   // (4.1.4) the metronome's
      if (mEnv > 0.001f) {                                                               // click, on its exact sample
        float ck = T[(int)(mPh * 1024.f) & 1023] * mEnv * 0.45f * vol;
        mPh += mInc; if (mPh >= 1.f) mPh -= 1.f;
        mEnv *= 0.9965f;                                                                 // (~13 ms, gone in ~90 ms)
        out[j] += ck; outR[j] += ck; busy = true;
      }
    }
    return busy && vol > 0.f;                         // (Sound off: the piezo parks, silent and switched off)
  }
  // ---- to the two DACs (stereo speaker): left in the low byte, right in the high byte ----
  // (4.1.4) Quiet when silent: after 4 s with nothing playing the speaker's resting level glides from mid-level to 0 V
  // (0.5 s), where the radios' supply noise can't get into the amp; any sound brings it back up in 60 ms (an S-curve,
  // the sound fading in with it). PLAY while parked waits for the glide (holdStart) so the first beat is whole.
  float restGain(int n) {
    bool quiet = P.quietRest && !play && idle > (uint32_t)HR_SR * 4;
    if (quiet) { rest -= n / (HR_SR * 0.5f); if (rest < 0.f) rest = 0.f; }
    else if (rest < 1.f) { rest += n / (HR_SR * 0.06f); if (rest > 1.f) rest = 1.f; }
    return rest >= 1.f ? 1.f : rest * rest * (3.f - 2.f * rest);
  }
  void convert2(const float* l, const float* r, uint16_t* o, int n, bool busy) {
    if (busy) idle = 0; else idle += n;
    float rg = restGain(n);
    for (int i = 0; i < n; i++) {
      int a = 128 + (int)(l[i] * 126.f), b = 128 + (int)(r[i] * 126.f);
      if (rg < 1.f) { a = (int)(a * rg); b = (int)(b * rg); }
      a = a < 0 ? 0 : a > 255 ? 255 : a; b = b < 0 ? 0 : b > 255 ? 255 : b;
      o[i] = (uint16_t)(a | (b << 8));
      int d = a > 128 ? a - 128 : 128 - a, e = b > 128 ? b - 128 : 128 - b; if (e > d) d = e;
      if (d > oPk) oPk = d > 127 ? 127 : d;
    }
  }
  // ---- to the DAC: 8-bit (speaker / AUX) or 1-bit at 8 x the rate (piezo amp) ----
  int convert(const float* in, uint8_t* o, int n, bool busy) {
    if (busy) idle = 0; else idle += n;
    if (mode == 1) {
      float rg = restGain(n);                         // (4.1.4) the quiet rest, as above
      for (int i = 0; i < n; i++) {
        int x = 128 + (int)(in[i] * 126.f);
        if (rg < 1.f) x = (int)(x * rg);
        o[i] = x < 0 ? 0 : x > 255 ? 255 : x;
        int d = x > 128 ? x - 128 : 128 - x;
        if (d > oPk) oPk = d > 127 ? 127 : d;
      }
      return n;
    }
    if (mode == 2) {                                // piezo through the PWM (timer path): the duty follows the sound,
      if (busy) park += n / 1100.f; else if (idle > (uint32_t)HR_SR) park -= n / 4400.f;   // 0 (transistor off) when parked
      if (park > 1.f) park = 1.f; else if (park < 0.f) park = 0.f;
      for (int i = 0; i < n; i++) { int x = (int)((128.f + in[i] * 126.f) * park); o[i] = x < 0 ? 0 : x > 255 ? 255 : x; }
      return n;
    }
    // piezo: a second-order sigma-delta at 176 kHz. When nothing plays for a second it parks at 0 V (transistor off,
    // no current, no hiss), fading in and out slowly so the piezo doesn't click.
    if (busy) park += n / 1100.f; else if (idle > (uint32_t)HR_SR) park -= n / 4400.f;
    if (park > 1.f) park = 1.f;
    if (park <= 0.f) { park = 0.f; memset(o, 0, n * 8); i1 = i2 = prev = 0.f; yq = -1.f; return n * 8; }
    int m = 0;
    for (int i = 0; i < n; i++) {
      float b = in[i] * 0.72f * park + (park - 1.f) * 0.8f, a = prev, d = (b - a) * 0.125f;
      prev = b;
      for (int j = 0; j < 8; j++) {
        a += d;
        float x = a + frand() * 0.002f;
        i1 += x - yq; i2 += i1 - yq;
        if (i1 > 4.f) i1 = 4.f; else if (i1 < -4.f) i1 = -4.f;
        if (i2 > 4.f) i2 = 4.f; else if (i2 < -4.f) i2 = -4.f;
        yq = i2 >= 0.f ? 1.f : -1.f;
        o[m++] = yq > 0.f ? 255 : 0;
      }
    }
    return m;
  }
};
HrEng* HE = nullptr;
dac_continuous_handle_t hrDac = nullptr;
volatile bool hrQuit = false, hrTaskDone = true;
// The sound leaves one of two ways. DMA: the DAC's own DMA plays the blocks (best). Timer: if the DMA won't start,
// a 22 kHz timer interrupt (like web sound) takes one sample at a time from a small ring and sets the DAC (speaker /
// AUX) or the PWM duty of a 156 kHz LEDC carrier (piezo amp: the transistor switches, the piezo averages it).
enum { HO_DMA, HO_TIMER_DAC, HO_TIMER_PWM };
volatile uint8_t hrOutKind = HO_DMA, hrLedcGrp = 0, hrLedcCh = 0;
volatile uint16_t hrLastV = 0;                       // (left in the low byte, right in the high byte)
volatile bool hrStereoOut = false;                   // (4.1) the timer feeds DAC2 (D26) too
const uint16_t HR_RING = 1024;
// (4.2) The engine's block buffers and the ring to the speaker: 4.3 KB that used to be set aside all the time. Now
// they're made when HOWL RACK starts its sound and freed with the engine when the app closes.
struct HrBufs { float mix[128], mixR[128]; uint8_t out[1024]; uint16_t out2[128]; uint16_t ring[HR_RING]; };
HrBufs* HB = nullptr;
volatile uint16_t hrRh = 0, hrRt = 0;
hw_timer_t* hrTimer = nullptr;
char hrDacErr[48] = "";                             // why the DMA didn't start (shown once, and on Serial)
volatile uint32_t hrIsrN = 0;                       // (the Serial heartbeat: interrupts so far)
void hrIsr() {                                      // 22050 times a second (timer path only; this core pauses timer
                                                    // interrupts while flash is busy, so it can live in flash: IRAM is full)
  hrIsrN++;
  uint16_t v = hrLastV;
  if (hrRt != hrRh) { v = HB->ring[hrRt]; hrRt = (hrRt + 1) & (HR_RING - 1); hrLastV = v; }
  if (hrOutKind == HO_TIMER_DAC) {
    SET_PERI_REG_BITS(RTC_IO_PAD_DAC1_REG, RTC_IO_PDAC1_DAC, v & 255, RTC_IO_PDAC1_DAC_S);   // DAC1 = GPIO25 (left)
    if (hrStereoOut) SET_PERI_REG_BITS(RTC_IO_PAD_DAC2_REG, RTC_IO_PDAC2_DAC, v >> 8, RTC_IO_PDAC2_DAC_S);   // DAC2 = GPIO26 (right)
  } else {
    ledc_ll_set_duty_int_part(&LEDC, (ledc_mode_t)hrLedcGrp, (ledc_channel_t)hrLedcCh, (uint32_t)(v & 255) << 1);   // 0..510 of 512
    ledc_ll_set_duty_start(&LEDC, (ledc_mode_t)hrLedcGrp, (ledc_channel_t)hrLedcCh);
    if (hrLedcGrp) ledc_ll_ls_channel_update(&LEDC, (ledc_mode_t)hrLedcGrp, (ledc_channel_t)hrLedcCh);
  }
}
// (4.1.4) Where the song is, as you HEAR it: after every block the engine notes its place (in steps, the count-in
// included), each machine's step in its pattern, and how much sound is still queued before the speaker. loop() reads
// it (a sequence number guards against a half-written note) to put recorded notes where you played them.
static_assert(HR_SLOTS == 7, "HrPosSnap (near the top) has room for 7 machines");
HrPosSnap hrPosS;
volatile uint32_t hrPosSeq = 0;
void hrPosNote(uint16_t ring) {                      // (the engine's task)
  float sl = HR_SR * 15.f / (HS->bpm < 40 ? 40 : HS->bpm);
  hrPosSeq++; __sync_synchronize();
  hrPosS.play = HE->play; hrPosS.sl = sl; hrPosS.all = HE->gAll; hrPosS.pre = HE->preLen;
  hrPosS.g = HE->holdStart ? -1.f : (float)HE->gAll - HE->stepLeft / sl;   // (step k starts at g = k)
  for (int s = 0; s < HR_SLOTS; s++) { hrPosS.pos[s] = HE->pos[s]; hrPosS.pat[s] = HE->patNow[s]; }
  hrPosS.ring = ring; hrPosS.us = micros();
  __sync_synchronize(); hrPosSeq++;
}
bool hrPosRead(HrPosSnap& s) {                       // (loop()) a whole snapshot, never half of one
  for (int t = 0; t < 8; t++) {
    uint32_t a = hrPosSeq; __sync_synchronize();
    if (a & 1) { delayMicroseconds(20); continue; }
    s = hrPosS; __sync_synchronize();
    if (a == hrPosSeq) return true;
  }
  return false;
}
void hrTask(void*) {                                // core 0: render a block (5.8 ms), hand it on, repeat
  float* mix = HB->mix; float* mixR = HB->mixR;     // (4.2: these live in HB, see HrBufs)
  uint8_t* out = HB->out; uint16_t* out2 = HB->out2;
  while (!hrQuit) {
    bool busy = HE->render(mix, mixR, 128);
    int n;
    bool two = hrStereoOut && hrOutKind == HO_TIMER_DAC;
    if (two) { HE->convert2(mix, mixR, out2, 128, busy); n = 128; }
    else {                                            // one speaker / the piezo: the mono mix (a song without stereo: as before)
      for (int j = 0; j < 128; j++) mix[j] = (mix[j] + mixR[j]) * 0.5f;
      n = HE->convert(mix, out, 128, busy);
    }
    HE->blocks++;
    if (hrOutKind == HO_DMA) { dac_continuous_write(hrDac, out, n, nullptr, 250); hrPosNote(640); continue; }
    uint16_t keep = P.quickKeys ? 320 : 640;          // ~30 ms queued (4.1.4 quick keys: ~15 ms, a hair less safe)
    while (!hrQuit && ((hrRh - hrRt) & (HR_RING - 1)) > keep) vTaskDelay(1);
    for (int i = 0; i < n; i++) {
      uint16_t h = hrRh, nh = (h + 1) & (HR_RING - 1);
      if (nh == hrRt) break;
      HB->ring[h] = two ? out2[i] : (uint16_t)(out[i] | (out[i] << 8));
      __sync_synchronize();
      hrRh = nh;
    }
    hrPosNote((hrRh - hrRt) & (HR_RING - 1));
  }
  hrTaskDone = true;
  vTaskDelete(nullptr);
}
void hrAudioStop() {
  if (!hrOn) return;
  hrQuit = true;
  for (int i = 0; i < 80 && !hrTaskDone; i++) delay(5);
  if (hrTimer) { timerEnd(hrTimer); hrTimer = nullptr; }
  if (hrDac) { dac_continuous_disable(hrDac); dac_continuous_del_channels(hrDac); hrDac = nullptr; }
  if (hrOutKind == HO_TIMER_DAC) {                  // speaker: where HOWL left it (mid, or parked), the DAC stays on
    float r = HE ? HE->rest : 1.f;                  // for the beeps (no pop); the quiet rest goes on from there
    spkLevel = r >= 1.f ? 128 : (uint8_t)(128.f * r * r * (3.f - 2.f * r));
    spkDac(spkLevel); spkSoundAt = millis();
  }
  else {
    if (hrOutKind == HO_TIMER_PWM) ledcDetach(BUZZER_PIN);
    pinMode(BUZZER_PIN, OUTPUT); digitalWrite(BUZZER_PIN, LOW);
  }
  hrOn = false;
}
bool hrAudioStart() {
  if (hrOn) return true;
  if (!HS) return false;
  if (!HE) {
    HE = (HrEng*)calloc(1, sizeof(HrEng));
    if (!HE) { snprintf(hrDacErr, sizeof hrDacErr, "RAM full (%u KB free)", (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_8BIT) / 1024)); return false; }
    HE->init();
  }
  if (!HB) HB = (HrBufs*)calloc(1, sizeof(HrBufs));
  if (!HB) { snprintf(hrDacErr, sizeof hrDacErr, "RAM full (%u KB free)", (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_8BIT) / 1024)); return false; }
  for (int i = 0; i < 2; i++) if (!HE->dly[i]) HE->dly[i] = (int16_t*)calloc(4096, sizeof(int16_t));   // (no room: no echo)
  if (!hrQ) hrQ = xQueueCreate(48, sizeof(HrCmd));
  if (!hrQ) return false;
  HE->mode = P.sndOut ? 1 : 0; HE->park = 0.f; HE->idle = 0;
  soundAllOff();
  tgStop();                                         // (the beeper's tone timer)
  if (sndAttached) { ledcDetach(BUZZER_PIN); sndAttached = false; }   // the beeper's PWM lets go of D25
  hrOutKind = HO_DMA;
  if (P.sndOut) {                                   // speaker: the shared DAC, already at mid-level, fed by the timer
    spkUp();
    spkWake(); HE->rest = 1.f; HE->holdStart = false;   // (4.1.4: from the quiet rest; HOWL parks it itself from here)
    hrRh = hrRt = 0; hrLastV = 128 | (128 << 8); hrDacErr[0] = 0;
    hrStereoOut = spkStereo;                        // (4.1) D26 is on: the right side goes there
    hrOutKind = HO_TIMER_DAC; HE->mode = 1;
    hrTimer = timerBegin(40000000);
    if (!hrTimer) { snprintf(hrDacErr, sizeof hrDacErr, "no timer free"); return false; }
    timerAttachInterrupt(hrTimer, &hrIsr);
    timerAlarm(hrTimer, 1814, true, 0);
    hrOn = true; hrQuit = false; hrTaskDone = false;
    if (xTaskCreatePinnedToCore(hrTask, "howl", 6144, nullptr, 4, nullptr, 0) != pdPASS) { hrTaskDone = true; hrAudioStop(); return false; }
    return true;
  }
  dac_continuous_config_t cfg = {};
  cfg.chan_mask = DAC_CHANNEL_MASK_CH0;               // DAC1 = GPIO25
  cfg.desc_num = 4;
  cfg.buf_size = HE->mode ? 512 : 2048;              // 46 ms (speaker) / 23 ms (piezo) of sound queued
  cfg.freq_hz = HE->mode ? HR_SR : HR_SR * 8;
  cfg.offset = 0;
  cfg.clk_src = DAC_DIGI_CLK_SRC_DEFAULT;
  cfg.chan_mode = DAC_CHANNEL_MODE_SIMUL;
  esp_err_t e = dac_continuous_new_channels(&cfg, &hrDac);
  if (e != ESP_OK) { hrDac = nullptr; snprintf(hrDacErr, sizeof hrDacErr, "DMA: %s", esp_err_to_name(e)); }
  else if ((e = dac_continuous_enable(hrDac)) != ESP_OK) {
    dac_continuous_del_channels(hrDac); hrDac = nullptr;
    snprintf(hrDacErr, sizeof hrDacErr, "DMA on: %s", esp_err_to_name(e));
  }
  if (!hrDac) {                                     // the timer path instead
    Serial.printf("howl: the DAC's DMA didn't start (%s): using the timer\n", hrDacErr);
    hrRh = hrRt = 0; hrLastV = 0; hrStereoOut = false;
    if (P.sndOut) { dacWrite(BUZZER_PIN, 128); hrLastV = 128 | (128 << 8); hrOutKind = HO_TIMER_DAC; HE->mode = 1; }
    else {
      if (!ledcAttach(BUZZER_PIN, 156250, 9)) { snprintf(hrDacErr, sizeof hrDacErr, "no PWM channel either"); return false; }
      ledc_channel_handle_t* lh = (ledc_channel_handle_t*)perimanGetPinBus(BUZZER_PIN, ESP32_BUS_TYPE_LEDC);
      if (!lh) { ledcDetach(BUZZER_PIN); snprintf(hrDacErr, sizeof hrDacErr, "PWM: no channel info"); return false; }
      hrLedcGrp = lh->channel / 8; hrLedcCh = lh->channel % 8;
      ledcWrite(BUZZER_PIN, 0);
      hrOutKind = HO_TIMER_PWM; HE->mode = 2;
    }
    hrTimer = timerBegin(40000000);                 // 40 MHz ticks, an alarm every 1814 = 22051 a second
    if (!hrTimer) { snprintf(hrDacErr, sizeof hrDacErr, "no timer free"); hrOn = true; hrAudioStop(); return false; }
    timerAttachInterrupt(hrTimer, &hrIsr);
    timerAlarm(hrTimer, 1814, true, 0);
  } else hrDacErr[0] = 0;
  hrOn = true; hrQuit = false; hrTaskDone = false;
  if (xTaskCreatePinnedToCore(hrTask, "howl", 6144, nullptr, 4, nullptr, 0) != pdPASS) { hrTaskDone = true; hrAudioStop(); return false; }
  return true;
}
void hrSend(int op, int a, int b, int c, int d) {
  if (!hrQ || !hrOn) return;
  HrCmd m; m.op = op; m.a = a; m.b = b; m.c = c; m.d = d;
  xQueueSend(hrQ, &m, 0);
}

