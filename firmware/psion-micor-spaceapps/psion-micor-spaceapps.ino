    case PR_QUIET:    snprintf_P(b, n, PSTR("%s"), !P.sndOut ? FS("(speaker only)") : P.quietRest ? FS("on: no hum") : FS("off")); *col = (P.sndOut && P.quietRest) ? E_MINT : C_MID; break;
