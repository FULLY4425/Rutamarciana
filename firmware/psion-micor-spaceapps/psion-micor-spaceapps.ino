  putText(6, 108, 1, C_MID, C_LCD, FS("press: keep it    hold: as it was"));
  int lx = 99, ly = 99;
  bool keep = false;
  for (;;) {
    if (lx != P.oledDx || ly != P.oledDy) {         // the test picture, moved as set
      lx = P.oledDx; ly = P.oledDy;
      oledDx = lx; oledDy = ly;
      oled.clearDisplay();
      oled.drawRect(0, 0, 128, 64, SSD1306_WHITE);
