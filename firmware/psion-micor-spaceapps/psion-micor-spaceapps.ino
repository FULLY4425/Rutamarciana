bool spLock[SP_NET_MAX], spScanning = false, spInfoBt = false;
char spJoinSsid[33], spPass[65];
uint8_t spPassLen = 0;
uint32_t spJoinAt = 0, spAnimAt = 0;
uint8_t spDots = 0;

