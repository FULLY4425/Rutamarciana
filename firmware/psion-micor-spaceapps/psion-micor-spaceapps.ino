  static const uint8_t BELL[12][3] = {{0, 76, 4}, {6, 74, 2}, {8, 72, 6}, {16, 72, 4}, {22, 69, 2}, {24, 72, 6},
                                      {32, 79, 4}, {38, 76, 2}, {40, 74, 6}, {48, 74, 4}, {54, 71, 2}, {56, 74, 8}};
  for (int i = 0; i < 12; i++) hrN(6, 0, BELL[i][0], BELL[i][2], BELL[i][1], 12, 0);           // SPARK: the bell tune
  HS->m[2].pat[0].len = HS->m[3].pat[0].len = HS->m[3].pat[1].len = HS->m[4].pat[0].len = HS->m[6].pat[0].len = 64;
  HS->m[5].pat[0].len = 12;
  HS->m[3].cur = 1;
  static const uint8_t SEC[6][7] = {{2, X, 0, X, 0, X, X}, {0, 0, 0, X, X, 0, X}, {0, 0, 0, 0, X, 0, 0},
                                    {1, 0, 0, 1, X, 0, 0}, {2, X, X, X, 0, X, 0}, {1, 0, 0, 1, 0, 0, 0}};
  HS->nsec = 6;
  for (int i = 0; i < 6; i++) { HS->sec[i].len = 64; memcpy(HS->sec[i].pat, SEC[i], HR_SLOTS); }
}
void hrSanitize() {                                     // a song from a file: keep every number in range
  HrSong* S = HS;
  S->bpm = constrain(S->bpm, 40, 240); S->swing = constrain(S->swing, 0, 50); S->master = constrain(S->master, 0, 100);
  S->dlyTime %= 5; S->dlyFb = constrain(S->dlyFb, 0, 95); S->dlyMix = constrain(S->dlyMix, 0, 100);
  S->pad[0] &= 1; S->pad[1] &= 0x7F;                    // (4.1 stereo: ping-pong, auto-pan machines; PAN is clamped by the engine)
  memcpy(S->magic, "HOWL", 4); S->ver = 2;
  S->nsec = constrain(S->nsec, 1, HR_SECS);
  for (int i = 0; i < HR_SECS; i++) if (!S->sec[i].len) S->sec[i].len = 16;
  hrReindex();
  for (int s = 0; s < HR_SLOTS; s++) {
    HrMach& m = S->m[s];
    if (m.type >= MT_N) m.type = MT_NONE;
    m.cur &= 7; m.preset &= 3; m.vol = constrain(m.vol, 0, 100); m.send = constrain(m.send, 0, 100);
    for (int i = 0; i < HR_NPRM[m.type]; i++) m.prm[i] = constrain(m.prm[i], 0, HR_PRMS[m.type][i].max);
    for (int p = 0; p < HR_PATS; p++) {
      HrPat& P = m.pat[p];
      if (!P.len || P.len > HR_STEPS) P.len = 16;
      P.pad = 0;
      HrNote* PN = S->pool + P.off;
      for (int i = 0; i < P.n; i++) { HrNote& N = PN[i]; if (N.at >= HR_STEPS) N.at = HR_STEPS - 1; N.key &= 127; N.fx &= ~12;
                                      if (!N.len || N.at + N.len > HR_STEPS) N.len = HR_STEPS - N.at; }
    }
    hrGen[s]++;
  }
}
bool hrSave() {
  if (!fsOk || !hrName[0] || !HS) return false;
  LittleFS.mkdir(FS("/music"));
  char p[40]; snprintf_P(p, sizeof p, PSTR("/music/%s.howl"), hrName);
  File f = LittleFS.open(p, FS("w"));
  if (!f) return false;
  size_t n = 0, want;
  if (hrFitsV1()) {                                     // (4.3) format 1 when it fits: older Psions + HOWL RACK PC 4.1 open it
    static const uint8_t Z[64] = {0};
    uint8_t h[16]; memcpy(h, HS, 16); h[4] = 1;
    n += f.write(h, 16); n += f.write((const uint8_t*)HS->sec, HR_SECS1 * sizeof(HrSec));
    for (int s = 0; s < HR_SLOTS; s++) {
      n += f.write((const uint8_t*)&HS->m[s], 8 + HR_PRM);
      for (int q = 0; q < HR_PATS; q++) {
        HrPat& Pt = HS->m[s].pat[q];
        uint8_t ph[4] = {Pt.len, (uint8_t)Pt.n, 0, 0};
        n += f.write(ph, 4); n += f.write((const uint8_t*)hrNotes(s, q), Pt.n * sizeof(HrNote));
        for (int k = Pt.n * 4; k < HR_NOTES1 * 4; k += 64) n += f.write(Z, min(64, HR_NOTES1 * 4 - k));
      }
    }
    want = HR_V1_SIZE;
  } else {                                              // format 2: the song up to the pool, then its notes
    HS->ver = 2;
    n += f.write((const uint8_t*)HS, HR_HEAD); n += f.write((const uint8_t*)HS->pool, HS->total * sizeof(HrNote));
    want = HR_HEAD + HS->total * sizeof(HrNote);
  }
  f.close();
  if (n != want) return false;
  hrDirty = false;
  return true;
}
bool hrImportSq(const char* path) {                     // an old 3-track song: lead -> BLIP, bass -> DEN, drums -> PAWBEAT
  File f = LittleFS.open(path, FS("r"));
  if (!f) return false;
  SeqSong t;
  bool ok = f.size() == sizeof t && f.read((uint8_t*)&t, sizeof t) == (int)sizeof t && t.ver == 1;
  f.close();
  if (!ok) return false;
  hrBlank();
  HS->bpm = constrain(t.bpm, 40, 240); HS->swing = constrain(t.swing, 0, 50);
  static const uint8_t DEST[2] = {5, 2}, LANE[6] = {0, 0, 1, 3, 5, 7};
  for (int p = 0; p < SQ_PATS; p++) {
    for (int tr = 0; tr < 2; tr++)
      for (int st = 0; st < SQ_STEPS; st++) {
        uint8_t v = t.cell[p][tr][st];
        if (v < 2) continue;
        int e = st + 1;
        while (e < SQ_STEPS && t.cell[p][tr][e] == 0) e++;
        hrAddNote(DEST[tr], p, st, ((t.gate >> tr) & 1) ? 1 : e - st, constrain(v + 22 + t.transpose, 0, 127), 12 << 4);
      }
    for (int st = 0; st < SQ_STEPS; st++) { uint8_t v = t.cell[p][2][st]; if (v >= 1 && v <= 5) hrAddNote(0, p, st, 1, LANE[v], 12 << 4); }
  }
  HS->nsec = constrain(t.len, 1, SQ_ORDER);
  for (int i = 0; i < HS->nsec; i++) {
    HS->sec[i].len = 16;
    memset(HS->sec[i].pat, 255, HR_SLOTS);
    HS->sec[i].pat[0] = HS->sec[i].pat[2] = HS->sec[i].pat[5] = t.order[i] % SQ_PATS;
  }
  baseName(path, hrName, sizeof hrName);
  hrSongMode = true;
  hrDirty = true;                                       // (saved as name.howl when you leave)
  return true;
}
bool hrLoad(const char* path) {
  if (strstr_P(lowerName(path), PSTR(".sq"))) return hrImportSq(path);
  File f = LittleFS.open(path, FS("r"));
  if (!f) return false;
  char hdr[5];                                          // check it first, then read it straight in (no 15 KB copy)
  size_t fsz = f.size();
  bool ok = f.read((uint8_t*)hdr, 5) == 5 && !memcmp(hdr, "HOWL", 4) && ((hdr[4] == 1 && fsz == HR_V1_SIZE) || (hdr[4] == 2 && fsz >= HR_HEAD));
  if (ok) {
    hrSend(HC_STOP, 0, 0, 0, 0); hrPlay = false;
    bool was = hrOn;
    hrAudioStop();                                      // (the synth mustn't read a half-loaded song)
    f.seek(0);
    memset(HS, 0, sizeof(HrSong));
    if (hdr[4] == 1) {                                  // (4.3) format 1: 64 sections, 64 notes a pattern, read piece by piece
      ok = f.read((uint8_t*)HS, 16) == 16 && f.read((uint8_t*)HS->sec, HR_SECS1 * sizeof(HrSec)) == (int)(HR_SECS1 * sizeof(HrSec));
      for (int i = HR_SECS1; i < HR_SECS; i++) HS->sec[i].len = 16;
      uint32_t at = 0;
      for (int s = 0; s < HR_SLOTS && ok; s++) {
        ok = f.read((uint8_t*)&HS->m[s], 8 + HR_PRM) == 8 + HR_PRM;
        for (int q = 0; q < HR_PATS && ok; q++) {
          uint8_t ph[4]; ok = f.read(ph, 4) == 4;
          int nn = ph[1] > HR_NOTES1 ? HR_NOTES1 : ph[1];
          HrPat& Pt = HS->m[s].pat[q]; Pt.len = ph[0] > HR_STEPS1 ? 16 : ph[0]; Pt.n = nn; Pt.off = at;
          ok = ok && f.read((uint8_t*)(HS->pool + at), nn * 4) == nn * 4; at += nn;
          ok = ok && f.seek(f.position() + (HR_NOTES1 - nn) * 4);
        }
      }
      HS->total = at;
    } else {                                            // format 2: the fixed part, then the notes
      ok = f.read((uint8_t*)HS, HR_HEAD) == (int)HR_HEAD;
      hrReindex();
      uint32_t have = (fsz - HR_HEAD) / sizeof(HrNote);
      if (have < HS->total) {                           // (a cut-off file: keep the notes that are there)
        for (int s = 0; s < HR_SLOTS; s++) for (int q = 0; q < HR_PATS; q++) { HrPat& Pt = HS->m[s].pat[q];
          if (Pt.off >= have) Pt.n = 0; else if (Pt.off + Pt.n > have) Pt.n = have - Pt.off; }
        hrReindex();
      }
      ok = ok && f.read((uint8_t*)HS->pool, HS->total * sizeof(HrNote)) == (int)(HS->total * sizeof(HrNote));
    }
    if (ok) { hrSanitize(); baseName(path, hrName, sizeof hrName); hrDirty = false; }
    else hrDemo();                                      // (a broken file: back to something that plays)
    rlLastSlot = -1;
    if (was) hrAudioStart();
  }
  f.close();
  return ok;
}
void hrAutoSave() { if (HS && hrDirty) { if (!hrName[0]) strcpy_P(hrName, PSTR("untitled")); hrSave(); } }

// ---------- drawing: the toolbar every page has ----------
void hrHint(const char* s) { tft.fillRect(0, 224, W, 16, HR_BG); putText(4, 228, 1, HR_DIM, HR_BG, s); }
void hrTitle() {
  char b[28];
  int t = HS->m[hrSlot].type;
  switch (hrPage) {
    case HP_ROLL: snprintf_P(b, sizeof b, PSTR("%d %s %c"), hrSlot + 1, HR_TNAME[t], 'A' + HS->m[hrSlot].cur); break;
    case HP_SOUND: snprintf_P(b, sizeof b, PSTR("%d %s"), hrSlot + 1, HR_TNAME[t]); break;
    case HP_SONG: snprintf_P(b, sizeof b, PSTR("Arrange")); break;
    case HP_MIX: snprintf_P(b, sizeof b, PSTR("Mixer")); break;
    case HP_HELP: snprintf_P(b, sizeof b, PSTR("How to use")); break;
    default: snprintf_P(b, sizeof b, PSTR("HOWL RACK"));
  }
  drawTitleBar(b, (hrPage == HP_ROLL || hrPage == HP_SOUND) ? HR_COL[t] : hrAcc());
}
int hrBarN() { return hrPage == HP_SOUND ? 4 : 6; }
void hrBarRect(int i, int* x, int* w) {
  static const int SX[4] = {1, 63, 125, 257}, SW[4] = {60, 60, 130, 62};
  if (hrPage == HP_SOUND) { *x = SX[i & 3]; *w = SW[i & 3]; } else { *x = 1 + i * 53; *w = 52; }
}
void hrBarLabel(int i, char* b, int n) {
  HrMach& m = HS->m[hrSlot];
  char l[8];
  switch (hrPage) {
    case HP_RACK:
      if (i == 0) snprintf_P(b, n, PSTR("%s"), hrPlay ? "STOP" : "PLAY");
      else if (i == 1) snprintf_P(b, n, PSTR("%s"), hrSongMode ? "SONG" : "LOOPS");
      else if (i == 2) snprintf_P(b, n, PSTR("BPM %d"), HS->bpm);
      else snprintf_P(b, n, PSTR("%s"), i == 3 ? "ARRANGE" : i == 4 ? "MIXER" : "MENU");
      break;
    case HP_ROLL:
      if (i == 0) snprintf_P(b, n, PSTR("%s"), hrKeys == HK_STEP ? "STEP IN" : hrKeys == HK_REC ? "LIVE REC" : "FREEPLAY");
      else if (i == 1) snprintf_P(b, n, PSTR("%s%s"), hrPlay ? "STOP" : "PLAY", hrRec ? " REC" : "");
      else if (i == 2) snprintf_P(b, n, PSTR("PAT %c"), 'A' + m.cur);
      else if (i == 3) snprintf_P(b, n, PSTR("LOOP %d"), hrPatLen(hrSlot, m.cur));
      else if (i == 4) { hrLenName(rlNewLen, l, sizeof l); snprintf_P(b, n, PSTR("NEW %s"), l); }
      else snprintf_P(b, n, PSTR("MENU"));
      break;
    case HP_SOUND:
      if (i == 0) snprintf_P(b, n, PSTR("< RACK"));
      else if (i == 1) snprintf_P(b, n, PSTR("ROLL"));
      else if (i == 2) snprintf_P(b, n, PSTR("PRESET: %s"), HR_PNAME[m.type][m.preset & 3]);
      else snprintf_P(b, n, PSTR("TEST"));
      break;
    case HP_SONG: {
      static const char* const L[6] = {"< RACK", "", "+ COPY", "- DEL", "", "CAPTURE"};
      if (i == 1) snprintf_P(b, n, PSTR("%s"), hrPlay ? "STOP" : "PLAY");
      else if (i == 4) snprintf_P(b, n, PSTR("%s"), HS->loop ? "LOOP ON" : "LOOP OFF");
      else snprintf_P(b, n, PSTR("%s"), L[i % 6]);
      break;
    }
    case HP_MIX: {
      static const char* const DL[5] = {"1/16", "1/8", "3/16", "1/4", "3/8"};
      if (i == 0) snprintf_P(b, n, PSTR("< RACK"));
      else if (i == 1) snprintf_P(b, n, PSTR("SWING %d"), HS->swing);
      else if (i == 2) snprintf_P(b, n, PSTR("%s %s"), (HS->pad[0] & 1) ? "PP" : "DLY", DL[HS->dlyTime % 5]);
      else if (i == 3) snprintf_P(b, n, PSTR("FBK %d"), HS->dlyFb);
      else if (i == 4) snprintf_P(b, n, PSTR("WET %d"), HS->dlyMix);
      else snprintf_P(b, n, PSTR("MAIN %d"), HS->master);
      break;
    }
    default: b[0] = 0;
  }
}
uint16_t hrBarBg(int i) {
  if (hrEdit == i) return HR_HOT;
  bool playBtn = (hrPage == HP_RACK && i == 0) || ((hrPage == HP_ROLL || hrPage == HP_SONG) && i == 1);
  if (playBtn && hrPlay) return (hrRec && hrPage == HP_ROLL) ? E_CORAL : E_MINT;
  if (playBtn && hrRec && hrPage == HP_ROLL) return RGB565(120, 40, 40);
  if (hrPage == HP_ROLL && i == 0 && hrKeys != HK_FREE) return hrKeys == HK_REC ? RGB565(120, 40, 40) : HR_MODE;
  if ((hrPage == HP_RACK && i == 1 && hrSongMode) || (hrPage == HP_SONG && i == 4 && HS->loop)) return HR_MODE;
  return HR_RAIL;
}
void hrDrawBar(int i) {
  if (i < 0 || i >= hrBarN()) return;
  int x, w; hrBarRect(i, &x, &w);
  char b[28]; hrBarLabel(i, b, sizeof b);
  uint16_t bg = hrBarBg(i), fg = (bg == HR_RAIL || bg == HR_MODE || bg == RGB565(120, 40, 40)) ? HR_TXT : HR_INK;
  tft.fillRect(x, 20, w, 17, bg);
  if (hrFocus == i && hrEdit != i) { tft.drawRect(x, 20, w, 17, HR_TXT); tft.drawRect(x + 1, 21, w - 2, 15, HR_TXT); }
  putText(x + (w - (int)strlen(b) * 6) / 2, 25, 1, fg, bg, b);
}
void hrDrawBars() { for (int i = 0; i < hrBarN(); i++) hrDrawBar(i); }
void hrPageTop() { hrTitle(); tft.fillRect(0, TITLE_H, W, H - TITLE_H, HR_BG); hrDrawBars(); }

// ---------- the RACK page ----------
void hrDrawPatBox(int s, int p) {
  HrMach& m = HS->m[s];
  int x = 158 + p * 16, y = 58 + s * 24, t = m.type;
  bool cur = p == hrSlotPat(s), has = m.pat[p].n > 0;
  uint16_t pan = HR_PAN[t], col = HR_COL[t];
  uint16_t bg = cur ? col : has ? hrBlend(pan, col, 80) : hrBlend(pan, 0, 70), fg = cur ? HR_INK : has ? HR_TXT : HR_DIM;
  if (cur && hrEdit == 6 + s) bg = HR_HOT;
  tft.fillRect(x, y, 14, 15, bg);
  char b[2] = {(char)('A' + p), 0};
  putText(x + 4, y + 4, 1, fg, bg, b);
}
void hrUnitState(int s) {                               // right end of a unit: MUTE / SOLO / the loop length
  HrMach& m = HS->m[s];
  int t = m.type, y = 58 + s * 24;
  if (!t) return;
  char b[6];
  uint16_t bg = HR_PAN[t], fg = HR_DIM;
  if (m.mute) { strcpy_P(b, PSTR("MUTE")); bg = E_CORAL; fg = HR_TXT; }
  else if (m.solo) { strcpy_P(b, PSTR("SOLO")); bg = HR_HOT; fg = HR_INK; }
  else { int p = hrSlotPat(s); if (p < HR_PATS) snprintf_P(b, sizeof b, PSTR("%d"), hrPatLen(s, p)); else strcpy_P(b, PSTR("--")); }
  tft.fillRect(290, y, 28, 15, bg);
  putText(290 + (28 - (int)strlen(b) * 6) / 2, y + 4, 1, fg, bg, b);
}
void hrMeter(int s, bool force) {
  int t = HS->m[s].type;
  if (!t) return;
  int w = constrain((int)(sqrtf(hrLvl[s]) * 48.f), 0, 48);
  if (!force && w == hrMeterW[s]) return;
  hrMeterW[s] = w;
  int y = 54 + s * 24 + 14;
  tft.fillRect(104, y, w, 5, HR_COL[t]);
  tft.fillRect(104 + w, y, 48 - w, 5, hrBlend(HR_PAN[t], 0, 90));
}
void hrDrawUnit(int s) {
  HrMach& m = HS->m[s];
  int t = m.type, y = 54 + s * 24;
  bool foc = hrPage == HP_RACK && hrFocus == 6 + s, ed = hrEdit == 6 + s;
  uint16_t pan = HR_PAN[t], col = HR_COL[t];
  tft.fillRect(0, y, W, 23, pan);
  tft.fillRect(0, y, 4, 23, col);
  char b[4] = {(char)('1' + s), 0};
  putText(7, y + 8, 1, HR_DIM, pan, b);
  if (!t) putText(18, y + 8, 1, HR_DIM, pan, FS("+ empty slot: press to add a machine"));
  else {
    putText(16, y + 4, 2, col, pan, HR_TNAME[t]);
    putText(104, y + 3, 1, HR_TXT, pan, HR_TK2[t]);
    for (int p = 0; p < HR_PATS; p++) hrDrawPatBox(s, p);
    hrUnitState(s);
    hrMeter(s, true);
  }
  if (foc || ed) { uint16_t fc = ed ? HR_HOT : HR_TXT; tft.drawRect(0, y, W, 23, fc); tft.drawRect(1, y + 1, W - 2, 21, fc); }
  hrShownPat[s] = hrSlotPat(s);
}
void hrDrawPos() {                                      // right of the info line: where the song is
  char b[34];
  if (hrPlay && HE) {
    uint32_t st = hrSongMode ? HE->secStep : HE->gStep;
    if (st) st--;
    if (hrSongMode) snprintf_P(b, sizeof b, PSTR("section %d/%d  bar %lu.%lu"), HE->sec + 1, HS->nsec, (unsigned long)(st / 16 + 1), (unsigned long)(st % 16 / 4 + 1));
    else snprintf_P(b, sizeof b, PSTR("bar %lu.%lu  %d bpm"), (unsigned long)(st / 16 + 1), (unsigned long)(st % 16 / 4 + 1), HS->bpm);
  } else snprintf_P(b, sizeof b, PSTR("%s  %d bpm  swing %d%%"), hrSongMode ? "song" : "loops", HS->bpm, HS->swing);
  tft.fillRect(158, 40, W - 158, 11, HR_BG);              // (left of 158: the name + MIDI / REC badges)
  putText(W - 4 - (int)strlen(b) * 6, 42, 1, HR_DIM, HR_BG, b);
}
void hrDrawInfo() {
  tft.fillRect(0, 40, W, 11, HR_BG);
  char b[24];
  snprintf_P(b, sizeof b, PSTR("%.14s%s"), hrName[0] ? hrName : "untitled", hrDirty ? "*" : "");
  putText(4, 42, 1, HR_TXT, HR_BG, b);
  int mx = 4 + (int)strlen(b) * 6 + 8;
  if (btMidi && btConnected) { putText(mx, 42, 1, HR_HOT, HR_BG, FS("MIDI")); mx += 30; }
  if (hrKeys == HK_REC) { tft.fillRect(mx - 2, 41, 22, 10, E_CORAL); putText(mx, 42, 1, HR_TXT, E_CORAL, FS("REC")); }
  else if (hrKeys == HK_STEP) putText(mx, 42, 1, HR_DIM, HR_BG, FS("STEP"));
  hrDrawPos();
}
void hrRackHint() {
  if (hrEdit == 2) hrHint(FS("turn: tempo   press: done"));
  else if (hrEdit >= 6) hrHint(FS("turn: pattern A-H (it plays at once)   press: done"));
  else if (hrFocus >= 6) hrHint(FS("press: notes, sound, pattern...   hold: leave"));
  else hrHint(FS("turn: pick   press: use it   hold: leave the app"));
}
void hrDrawRack() {
  hrPageTop();
  hrDrawInfo();
  for (int s = 0; s < HR_SLOTS; s++) hrDrawUnit(s);
  hrRackHint();
}

// ---------- the PIANO ROLL page ----------
bool rlDrums() { return HS->m[hrSlot].type == MT_PAW; }
int rlRows() { return rlDrums() ? 8 : 14; }
int rlRowH() { return rlDrums() ? 21 : 12; }
int rlKeyOf(int r) { return rlDrums() ? 7 - r : rlTop - r; }
int rlRowOf(int key) { return rlDrums() ? 7 - key : rlTop - key; }
void rlCell(int st, int r) {
  int cw = rlCw();
  if (r < 0 || r >= rlRows() || st < rlV0 || st >= rlV0 + rlVis()) return;
  int rh = rlRowH(), x = 28 + (st - rlV0) * cw, y = 48 + r * rh, key = rlKeyOf(r);
  HrMach& m = HS->m[hrSlot];
  bool drums = m.type == MT_PAW, out = st >= hrPatLen(hrSlot, m.cur);
  uint16_t bg = out ? RL_OUT : drums ? ((r & 1) ? RL_B : RL_W) : (hrIsBlack(key) ? RL_B : RL_W);
  tft.fillRect(x, y, cw, rh, bg);
  tft.drawFastVLine(x, y, rh, st % 16 == 0 ? RL_BARL : st % 4 == 0 ? RL_BEAT : RL_LINE);
  tft.drawFastHLine(x, y + rh - 1, cw, (!drums && key % 12 == 0) ? RL_BEAT : RL_LINE);
  int ni = hrNoteAt(hrSlot, m.cur, st, key);
  if (ni >= 0) {
    HrNote& N = hrNotes(hrSlot, m.cur)[ni];
    int vel = (N.fx >> 4) ? (N.fx >> 4) : 12;
    uint16_t c = ni == rlNote ? HR_HOT : hrBlend(HR_PAN[m.type], HR_COL[m.type], 110 + vel * 9);
    if (out) c = hrBlend(bg, c, 90);
    if (drums) {
      int g = cw >= 18 ? 3 : 1;
      tft.fillRect(x + g, y + 3, cw - 2 * g, rh - 6, c);
      if (N.fx & 1) { tft.drawRect(x + g - 1, y + 2, cw - 2 * g + 2, rh - 4, HR_TXT); tft.fillRect(x + cw / 3, y + rh / 2 - 1, cw / 3 + 1, 2, HR_INK); }
    } else {
      bool first = st == N.at, last = st == N.at + N.len - 1;
      int x0 = x + (first ? (cw >= 18 ? 2 : 1) : 0), x1 = x + cw - (last ? (cw >= 18 ? 2 : 1) : 0);
      tft.fillRect(x0, y + 2, x1 - x0, rh - 4, c);
      if (first) tft.drawFastVLine(x0, y + 2, rh - 4, HR_TXT);
      if (N.fx & 1) tft.drawFastHLine(x0, y + 2, x1 - x0, HR_TXT);               // accent: a bright top edge
      if ((N.fx & 2) && last) tft.drawLine(x1 - min(7, cw - 2), y + rh - 3, x1 - 1, y + 2, HR_INK);   // slide: a little ramp
    }
  }
  if (hrPage == HP_ROLL && hrFocus == 6 && st == rlStep && key == rlKey) {
    tft.drawRect(x, y, cw, rh, HR_TXT); tft.drawRect(x + 1, y + 1, cw - 2, rh - 2, HR_TXT);
  }
}
void rlKeyLabel(int r) {
  if (r < 0 || r >= rlRows()) return;
  int rh = rlRowH(), y = 48 + r * rh, key = rlKeyOf(r);
  HrMach& m = HS->m[hrSlot];
  bool cur = key == rlKey;
  char b[8];
  uint16_t bg, fg;
  if (m.type == MT_PAW) { bg = cur ? HR_COL[m.type] : HR_PAN[m.type]; fg = cur ? HR_INK : HR_TXT; snprintf_P(b, sizeof b, PSTR("%s"), HR_LANE4[key & 7]); }
  else {
    bool blk = hrIsBlack(key);
    bg = cur ? HR_COL[m.type] : blk ? RGB565(28, 30, 36) : RGB565(206, 210, 218);
    fg = (cur || !blk) ? HR_INK : HR_TXT;
    hrKeyName(key, b, sizeof b);
  }
  tft.fillRect(0, y, 27, rh, bg);
  tft.drawFastHLine(0, y + rh - 1, 27, RL_LINE);
  putText(2, y + (rh - 8) / 2, 1, fg, bg, b);
}
void rlRuler(int j) {                                   // the step numbers over the grid (the playing step lit)
  int cw = rlCw(), st = rlV0 + j, x = 28 + j * cw;
  bool ph = st == rlPlayCol;
  uint16_t bg = ph ? HR_COL[HS->m[hrSlot].type] : HR_BG;
  tft.fillRect(x, 38, cw, 10, bg);
  char b[4] = "";
  if (st % 16 == 0) snprintf_P(b, sizeof b, PSTR("%d"), st / 16 + 1);
  else if (st % 4 == 0 && cw >= 9) strcpy_P(b, PSTR("."));
  putText(x + 2, 39, 1, ph ? HR_INK : (st % 16 ? HR_DIM : HR_TXT), bg, b);
}
void rlStatus() {
  tft.fillRect(0, 217, W, 23, HR_BG);
  char b[64], k[10];
  HrMach& m = HS->m[hrSlot];
  HrPat& P = m.pat[m.cur];
  int len = hrPatLen(hrSlot, m.cur);
  if (hrFocus < 6) snprintf_P(b, sizeof b, PSTR("pattern %c: %d/256 notes, loops every %d"), 'A' + m.cur, P.n, len);
  else {
    int ni = rlNote >= 0 ? rlNote : hrNoteAt(hrSlot, m.cur, rlStep, rlKey);
    if (m.type == MT_PAW) snprintf_P(k, sizeof k, PSTR("%s"), HR_LANE[rlKey & 7]); else hrKeyName(rlKey, k, sizeof k);
    int n = snprintf_P(b, sizeof b, PSTR("%s  step %d/%d"), k, rlStep + 1, len);
    if (ni >= 0 && ni < P.n) {
      HrNote& N = hrNotes(hrSlot, m.cur)[ni];
      char l[8]; hrLenName(N.len, l, sizeof l);
      int vel = (N.fx >> 4) ? (N.fx >> 4) : 12;
      if (m.type == MT_PAW) snprintf_P(b + n, sizeof b - n, PSTR("  %s"), (N.fx & 1) ? "ACCENT" : "hit");
      else snprintf_P(b + n, sizeof b - n, PSTR("  note %s vel %d%s%s"), l, vel, (N.fx & 1) ? " ACC" : "", (N.fx & 2) ? " SLIDE" : "");
    }
  }
  putText(4, 219, 1, rlNote >= 0 ? HR_HOT : HR_TXT, HR_BG, b);
  if (hrRec) { tft.fillRect(W - 28, 218, 26, 10, E_CORAL); putText(W - 24, 219, 1, HR_TXT, E_CORAL, FS("REC")); }
  const char* h;
  if (hrEdit >= 0) h = FS("turn: change   press: done");
  else if (hrFocus == 0) h = hrKeys == HK_STEP ? FS("MIDI keys write notes at the cursor (stopped)")
                           : hrKeys == HK_REC ? FS("MIDI keys record while it plays") : FS("MIDI keys just play   press: change");
  else if (hrFocus < 6) h = FS("turn: pick   press: use   hold: back to the rack");
  else if (rlNote >= 0) h = FS("turn:length  push+turn:pitch  press:ok  hold:menu");
  else if (m.type == MT_PAW) h = FS("turn: step  push+turn: drum  press: hit/accent/off");
  else h = FS("turn: time  push+turn: pitch  press: add / edit note");
  putText(4, 230, 1, HR_DIM, HR_BG, h);
}
void rlDrawGrid() {
  HrMach& m = HS->m[hrSlot];
  int len = hrPatLen(hrSlot, m.cur);
  int vis = rlVis();
  tft.fillRect(0, 38, 28, 10, HR_BG);
  char b[8]; snprintf_P(b, sizeof b, PSTR("%d/%d"), rlV0 / vis + 1, (len + vis - 1) / vis);
  putText(2, 39, 1, HR_DIM, HR_BG, b);
  for (int j = 0; j < vis; j++) rlRuler(j);
  int rows = rlRows();
  for (int r = 0; r < rows; r++) { rlKeyLabel(r); for (int j = 0; j < vis; j++) rlCell(rlV0 + j, r); }
  tft.fillRect(316, 38, 4, 179, HR_BG);
  // (4.3) where the screen is in the loop: a thin bar under the grid (dim: the whole loop, bright: what you see)
  tft.drawFastHLine(28, 216, 288, RL_LINE);
  int a = rlV0 * 288 / len, w = max(4, min(vis, len - rlV0) * 288 / len);
  tft.drawFastHLine(28 + a, 216, min(w, 288 - a), HR_COL[m.type]);
}
void rlEnter() {                                        // opening the roll: put the cursor somewhere useful
  HrMach& m = HS->m[hrSlot];
  if (rlLastSlot != hrSlot || rlLastType != m.type) {
    rlStep = 0;
    if (m.type == MT_PAW) rlKey = 0;
    else {
      HrNote* PN = hrNotes(hrSlot, m.cur); int n = hrCount(hrSlot, m.cur);
      int hi = -1, lo = 128;
      for (int i = 0; i < n; i++) { if (PN[i].key > hi) hi = PN[i].key; if (PN[i].key < lo) lo = PN[i].key; }
      rlKey = hi >= 0 ? (hi + lo) / 2 : (m.type == MT_FANG ? 45 : m.type == MT_DEN ? 36 : 60);
    }
    rlLastSlot = hrSlot; rlLastType = m.type;
  }
  rlNote = -1; rlPlayCol = -1;
}
void rlClamp() {
  int len = hrPatLen(hrSlot, HS->m[hrSlot].cur);
  if (rlStep >= len) rlStep = len - 1;
  if (rlStep < 0) rlStep = 0;
  rlV0 = rlStep / rlVis() * rlVis();
  if (rlDrums()) rlKey = constrain(rlKey, 0, 7);
  else { rlKey = constrain(rlKey, 0, 127); if (rlKey > rlTop || rlKey < rlTop - 13) rlTop = constrain(rlKey + 7, 13, 127); }
}
void hrDrawRoll() { rlClamp(); hrPageTop(); rlDrawGrid(); rlStatus(); }
void rlSpan(int at, int len, int key) { for (int st = at; st < at + len; st++) rlCell(st, rlRowOf(key)); }
void rlMoveTo(int st, int key) {                        // the cursor to a new cell (the view scrolls when it must)
  int os = rlStep, ok = rlKey;
  rlStep = st; rlKey = key;
  bool redraw = false;
  int nv = st / rlVis() * rlVis();
  if (nv != rlV0) { rlV0 = nv; redraw = true; }
  if (!rlDrums()) {
    if (key > rlTop) { rlTop = key; redraw = true; }
    else if (key < rlTop - 13) { rlTop = key + 13; redraw = true; }
  }
  if (redraw) rlDrawGrid();
  else {
    rlCell(os, rlRowOf(ok)); rlCell(st, rlRowOf(key));
    if (ok != key) { rlKeyLabel(rlRowOf(ok)); rlKeyLabel(rlRowOf(key)); }
  }
  rlStatus();
}
void rlPress() {                                        // press on the grid: add a note / edit it (drums: hit, accent, off)
  int s = hrSlot;
  HrMach& m = HS->m[s];
  HrNote* PN = hrNotes(s, m.cur);
  int ni = hrNoteAt(s, m.cur, rlStep, rlKey);
  if (m.type == MT_PAW) {
    if (ni < 0) { if (hrAddNote(s, m.cur, rlStep, 1, rlKey, 12 << 4) < 0) { rlStatus(); putText(4, 219, 1, E_CORAL, HR_BG, FS("full: 256 a pattern, 3584 a song")); return; } hrPreview(s, rlKey, 12, 0, 300); }
    else if (!(PN[ni].fx & 1)) { PN[ni].fx |= 1; hrPreview(s, rlKey, 15, 1, 300); }
    else hrDelNote(s, m.cur, ni);
    rlCell(rlStep, rlRowOf(rlKey)); hrDirty = true; rlStatus();
    return;
  }
  int ms = constrain(15000 / (HS->bpm ? HS->bpm : 120), 60, 600);
  if (ni >= 0) {
    rlNote = ni; rlStep = PN[ni].at;
    hrPreview(s, rlKey, PN[ni].fx >> 4, PN[ni].fx & 3, constrain(PN[ni].len * ms, 120, 900));
    if (rlStep < rlV0) { rlV0 = rlStep / rlVis() * rlVis(); rlDrawGrid(); } else rlSpan(PN[ni].at, PN[ni].len, rlKey);
    rlStatus();
    return;
  }
  int len = constrain(rlNewLen, 1, HR_STEPS - rlStep);
  ni = hrAddNote(s, m.cur, rlStep, len, rlKey, 12 << 4);
  if (ni < 0) { rlStatus(); putText(4, 219, 1, E_CORAL, HR_BG, FS("full: 256 a pattern, 3584 a song")); return; }
  hrPreview(s, rlKey, 12, 0, constrain(len * ms, 120, 900));
  rlSpan(rlStep, len, rlKey);
  hrDirty = true; rlStatus();
}
void rlBarEdit(int c) {                                 // turning while a toolbar value is picked
  HrMach& m = HS->m[hrSlot];
  if (hrEdit == 2) { m.cur = ((m.cur + c) % HR_PATS + HR_PATS) % HR_PATS; rlLastSlot = -1; rlEnter(); rlClamp(); hrTitle(); rlDrawGrid(); hrDrawBar(3); }
  else if (hrEdit == 3) {
    HrPat& P = m.pat[m.cur];
    P.len = constrain(hrPatLen(hrSlot, m.cur) + c * (abs(c) >= 3 ? 4 : 1), 1, HR_STEPS);
    rlClamp(); rlDrawGrid();
  } else if (hrEdit == 4) {
    int i = 0;
    while (i < 8 && HR_LENS[i] < rlNewLen) i++;
    rlNewLen = HR_LENS[constrain(i + (c > 0 ? 1 : -1), 0, 8)];
  }
  hrDrawBar(hrEdit); hrDirty = true; rlStatus();
}

// ---------- the SOUND page (knobs + presets) ----------
void hrBanner() {
  int t = HS->m[hrSlot].type;
  uint16_t pan = HR_PAN[t], col = HR_COL[t];
  tft.fillRect(0, 39, W, 27, pan);
  putText(8, 45, 2, col, pan, HR_TNAME[t]);
  int x = 8 + (int)strlen(HR_TNAME[t]) * 12 + 8;
  putText(x, 44, 1, HR_TXT, pan, HR_TKIND[t]);
  putText(x, 55, 1, HR_DIM, pan, HR_PNAME[t][HS->m[hrSlot].preset & 3]);
  switch (t) {                                          // a little picture for each machine
    case MT_GLACIER:
      for (int i = 0; i < 27; i++) tft.drawFastHLine(214, 39 + i, 106, hrBlend(pan, RGB565(150, 210, 255), i * 7));
      tft.fillTriangle(220, 65, 248, 43, 276, 65, RGB565(232, 244, 255));
      tft.fillTriangle(258, 65, 287, 47, 316, 65, RGB565(190, 222, 250));
      tft.fillTriangle(241, 49, 248, 43, 255, 49, RGB565(255, 255, 255));
      break;
    case MT_PAW: drawPaw(246, 52, 2, col); drawPaw(292, 56, 2, hrBlend(pan, col, 140)); break;
    case MT_FANG: for (int i = 0; i < 6; i++) tft.fillTriangle(222 + i * 16, 39, 236 + i * 16, 39, 229 + i * 16, 58 - (i & 1) * 7, RGB565(240, 240, 226)); break;
    case MT_LUNA:
      tft.fillCircle(292, 52, 11, RGB565(250, 240, 200)); tft.fillCircle(298, 48, 10, pan);
      for (int i = 0; i < 6; i++) tft.fillRect(222 + i * 9, 43 + (i * 7) % 17, 2, 2, HR_TXT);
      break;
    case MT_DEN: tft.fillRoundRect(244, 46, 60, 20, 10, RGB565(22, 6, 6)); tft.fillRect(244, 58, 60, 8, RGB565(22, 6, 6)); drawPaw(274, 57, 1, col); break;
    case MT_BLIP: for (int i = 0; i < 12; i++) tft.fillRect(218 + (i * 37) % 96, 42 + (i * 13) % 20, 5, 5, (i & 1) ? col : HR_TXT); break;
    case MT_SPARK:
      for (int d = 0; d < 3; d++) {
        tft.drawLine(270 + d, 40, 258 + d, 54, col); tft.drawLine(258 + d, 54, 276 + d, 51, col); tft.drawLine(276 + d, 51, 262 + d, 65, col);
      }
      break;
  }
}
void hrDrawKnob(int i) {
  HrMach& m = HS->m[hrSlot];
  int t = m.type;
  if (i >= HR_NPRM[t]) return;
  const HrPrm& pr = HR_PRMS[t][i];
  int x = (i % 4) * 80, y = 68 + (i / 4) * 38, v = m.prm[i];
  bool foc = hrFocus == 4 + i, ed = hrEdit == 4 + i;
  uint16_t pan = HR_PAN[t], col = HR_COL[t], bg = ed ? hrBlend(pan, col, 60) : pan;
  tft.fillRect(x + 1, y + 1, 78, 36, bg);
  int cx = x + 18, cy = y + 19;
  tft.fillCircle(cx, cy, 10, hrBlend(pan, 0, 120));
  tft.drawCircle(cx, cy, 10, hrBlend(pan, col, 100));
  float f = pr.max ? (float)v / pr.max : 0.f;
  int lit = (int)roundf(f * 10.f);
  for (int d = 0; d <= 10; d++) {                      // a ring of dots: how far it's turned
    float a = (-135.f + 27.f * d) * 0.0174533f;
    tft.fillRect(cx + (int)roundf(14.f * sinf(a)) - 1, cy - (int)roundf(14.f * cosf(a)) - 1, 2, 2, d <= lit ? col : hrBlend(pan, HR_TXT, 60));
  }
  float a = (-135.f + 270.f * f) * 0.0174533f;
  int ex = cx + (int)roundf(8.f * sinf(a)), ey = cy - (int)roundf(8.f * cosf(a));
  tft.drawLine(cx, cy, ex, ey, HR_TXT); tft.drawLine(cx + 1, cy, ex + 1, ey, HR_TXT);
  char b[12];
  putText(x + 35, y + 9, 1, HR_DIM, bg, pr.name);
  hrPrmText(t, i, v, b, sizeof b);
  putText(x + 35, y + 22, 1, ed ? HR_HOT : HR_TXT, bg, b);
  if (foc || ed) { uint16_t fc = ed ? HR_HOT : HR_TXT; tft.drawRect(x + 1, y + 1, 78, 36, fc); tft.drawRect(x + 2, y + 2, 76, 34, fc); }
}
void hrSoundHint() {
  if (hrEdit >= 4) hrHint(FS("turn: change it (you hear it)   press: done"));
  else if (hrFocus < 4) hrHint(FS("turn: pick   press: use   hold: back to the rack"));
  else hrHint(FS("turn: pick a knob   press: turn it   hold: back"));
}
void hrDrawSound() {
  hrPageTop();
  hrBanner();
  for (int i = 0; i < HR_NPRM[HS->m[hrSlot].type]; i++) hrDrawKnob(i);
  hrSoundHint();
}

// ---------- the ARRANGE page (song mode's list of sections) ----------
int sgItems() { return 6 + HS->nsec * 8 + (HS->nsec < HR_SECS ? 1 : 0); }
void sgNum(int row) {
  if (row < sgTop || row >= sgTop + 12 || row >= HS->nsec) return;
  int y = 52 + (row - sgTop) * 14;
  bool on = hrPlay && hrSongMode && HE && HE->sec == row;
  uint16_t bg = on ? E_MINT : (row == sgRow ? HR_RAIL : HR_BG);
  tft.fillRect(0, y, 21, 13, bg);
  char b[4]; snprintf_P(b, sizeof b, PSTR("%d"), row + 1);
  putText(18 - (int)strlen(b) * 6, y + 3, 1, on ? HR_INK : HR_DIM, bg, b);
}
void sgCell(int row, int col) {
  if (row < sgTop || row >= sgTop + 12 || row >= HS->nsec) return;
  int y = 52 + (row - sgTop) * 14, f = 6 + row * 8 + col, x, w;
  bool foc = hrFocus == f, ed = hrEdit == f;
  HrSec& S = HS->sec[row];
  char b[6] = "";
  uint16_t bg, fg = HR_TXT;
  if (col == 0) { x = 22; w = 31; snprintf_P(b, sizeof b, PSTR("%d"), S.len); bg = (row & 1) ? HR_RAIL : RGB565(32, 35, 44); }
  else {
    int s = col - 1, t = HS->m[s].type, p = S.pat[s];
    x = 54 + s * 38; w = 37; bg = t ? HR_PAN[t] : HR_BG;
    if (t) { if (p < HR_PATS) { b[0] = 'A' + p; b[1] = 0; fg = HR_COL[t]; } else { strcpy_P(b, PSTR("-")); fg = HR_DIM; } }
  }
  if (ed) { bg = HR_HOT; fg = HR_INK; }
  tft.fillRect(x, y, w, 13, bg);
  putText(x + (w - (int)strlen(b) * 6) / 2, y + 3, 1, fg, bg, b);
  if (foc && !ed) tft.drawRect(x, y, w, 13, HR_TXT);
}
void sgRowDraw(int row) {
  if (row < sgTop || row >= sgTop + 12) return;
  int y = 52 + (row - sgTop) * 14;
  tft.fillRect(0, y, W, 14, HR_BG);
  if (row > HS->nsec || (row == HS->nsec && HS->nsec >= HR_SECS)) return;
  if (row == HS->nsec) {                               // the last row: add one more
    bool foc = hrFocus == 6 + HS->nsec * 8;
    tft.fillRect(22, y, 296, 13, foc ? HR_RAIL : HR_BG);
    if (foc) tft.drawRect(22, y, 296, 13, HR_TXT);
    putText(30, y + 3, 1, foc ? HR_TXT : HR_DIM, foc ? HR_RAIL : HR_BG, FS("+ add a section (a copy of the last one)"));
    return;
  }
  sgNum(row);
  for (int c = 0; c < 8; c++) sgCell(row, c);
}
void sgRows() { for (int r = sgTop; r < sgTop + 12; r++) sgRowDraw(r); }
void sgHint() {
  if (hrEdit >= 6) hrHint((hrEdit - 6) % 8 == 0 ? FS("turn: how many steps (4 = a beat)   press: done") : FS("turn: pattern A-H or - (rests)   press: done"));
  else if (hrFocus < 6) hrHint(FS("PLAY starts at the picked section   hold: back"));
  else hrHint(FS("turn: pick   press: change it   hold: back"));
}
void hrDrawSong() {
  hrPageTop();
  tft.fillRect(0, 39, 21, 11, HR_BG); putText(4, 41, 1, HR_DIM, HR_BG, FS("#"));
  tft.fillRect(22, 39, 31, 11, HR_RAIL); putText(26, 41, 1, HR_TXT, HR_RAIL, FS("STEP"));
  for (int s = 0; s < HR_SLOTS; s++) {
    int t = HS->m[s].type, x = 54 + s * 38;
    tft.fillRect(x, 39, 37, 11, HR_PAN[t]);
    putText(x + (37 - (int)strlen(HR_TSHORT[t]) * 6) / 2, 41, 1, HR_COL[t], HR_PAN[t], HR_TSHORT[t]);
  }
  sgRows();
  sgHint();
}
void sgFocusRow() {                                     // keep the focused row on screen
  if (hrFocus < 6) return;
  int row = (hrFocus - 6) / 8, old = sgTop;
  if (row < HS->nsec) sgRow = row;
  if (row < sgTop) sgTop = row;
  else if (row >= sgTop + 12) sgTop = row - 11;
  if (sgTop != old) sgRows();
}

// ---------- the MIXER page ----------
void mxFader(int s) {
  HrMach& m = HS->m[s];
  int x = 2 + s * 45, f = 6 + s * 4;
  tft.fillRect(x, 53, 31, 120, HR_BG);
  tft.fillRect(x + 13, 56, 3, 104, HR_RAIL);
  for (int i = 0; i <= 4; i++) tft.drawFastHLine(x + 6, 60 + i * 24, 17, HR_RAIL);
  int y = 56 + (100 - m.vol) * 96 / 100;
  uint16_t cap = hrEdit == f ? HR_HOT : hrFocus == f ? HR_TXT : HR_COL[m.type];
  tft.fillRect(x + 3, y, 23, 8, cap); tft.drawFastHLine(x + 3, y + 4, 23, HR_INK);
  char b[6]; snprintf_P(b, sizeof b, PSTR("%d"), m.vol);
  putText(x + 3, 164, 1, hrFocus == f ? HR_TXT : HR_DIM, HR_BG, b);
}
// PAN (4.1): turn = left .. centre .. right; past hard right = "~" AUTO-PAN (sweeps left <-> right), then how long a
// sweep takes: 1, 2, 4 or 8 bars (one length for the whole song)
const uint8_t MX_SWEEP[4] = {16, 32, 64, 128};
int mxPanIdx(int s) {                                    // 0..32 = L64..R64 in 4s, 33..36 = auto-pan
  if (HS->pad[1] >> s & 1) { int b = 0; for (int i = 0; i < 4; i++) if (abs(MX_SWEEP[i] - HS->pad[2]) < abs(MX_SWEEP[b] - HS->pad[2])) b = i; return 33 + b; }
  return constrain(((int8_t)HS->m[s].pad + 64 + 2) / 4, 0, 32);
}
void mxPanSet(int s, int i) {
  i = constrain(i, 0, 36);
  if (i >= 33) { HS->pad[1] |= 1 << s; HS->m[s].pad = 0; HS->pad[2] = MX_SWEEP[i - 33]; }
  else { HS->pad[1] &= ~(1 << s); HS->m[s].pad = (uint8_t)(int8_t)(i * 4 - 64); }
}
void mxPan(int s) {
  HrMach& m = HS->m[s];
  int x = 2 + s * 45, f = 7 + s * 4, pv = (int8_t)m.pad;
  bool foc = hrFocus == f, ed = hrEdit == f, sweep = HS->pad[1] >> s & 1;
  uint16_t bg = ed ? HR_HOT : sweep ? HR_MODE : HR_RAIL, fg = ed ? HR_INK : HR_TXT;
  tft.fillRect(x, 174, 43, 13, bg);
  char b[8];
  if (sweep) snprintf_P(b, sizeof b, PSTR("~%dbar"), HS->pad[2] / 16);
  else if (!pv) snprintf_P(b, sizeof b, PSTR("C"));
  else snprintf_P(b, sizeof b, PSTR("%c%d"), pv < 0 ? 'L' : 'R', abs(pv));
  if (!sweep && pv) { int mk = x + 21 + pv * 19 / 64; tft.fillRect(mk - 1, 175, 3, 11, ed ? HR_INK : HR_COL[m.type]); }   // where it sits
  putText(sweep || !pv ? x + (43 - (int)strlen(b) * 6) / 2 : (pv < 0 ? x + 40 - (int)strlen(b) * 6 : x + 3), 177, 1, fg, bg, b);
  if (foc && !ed) tft.drawRect(x, 174, 43, 13, HR_TXT);
}
void mxVu(int s, bool force) {
  if (!HS->m[s].type) return;
  int h = constrain((int)(sqrtf(hrLvl[s]) * 104.f), 0, 104);
  if (!force && h == hrVuH[s]) return;
  hrVuH[s] = h;
  int x = 2 + s * 45 + 34;
  tft.fillRect(x, 56, 6, 104 - h, RGB565(30, 33, 40));
  tft.fillRect(x, 160 - h, 6, h, h > 90 ? E_CORAL : HR_COL[HS->m[s].type]);
}
void mxSend(int s) {
  HrMach& m = HS->m[s];
  int x = 2 + s * 45, f = 8 + s * 4;
  bool foc = hrFocus == f, ed = hrEdit == f;
  uint16_t bg = ed ? HR_HOT : HR_RAIL;
  tft.fillRect(x, 189, 43, 13, bg);
  char b[8]; snprintf_P(b, sizeof b, PSTR("fx %d"), m.send);
  putText(x + (43 - (int)strlen(b) * 6) / 2, 192, 1, ed ? HR_INK : HR_TXT, bg, b);
  if (foc && !ed) tft.drawRect(x, 189, 43, 13, HR_TXT);
}
void mxState(int s) {
  HrMach& m = HS->m[s];
  int x = 2 + s * 45, f = 9 + s * 4;
  uint16_t bg = m.mute ? E_CORAL : m.solo ? HR_HOT : HR_RAIL, fg = m.solo ? HR_INK : HR_TXT;
  const char* t = m.mute ? "MUTE" : m.solo ? "SOLO" : "ON";
  tft.fillRect(x, 205, 43, 15, bg);
  putText(x + (43 - (int)strlen(t) * 6) / 2, 209, 1, fg, bg, t);
  if (hrFocus == f) { tft.drawRect(x, 205, 43, 15, HR_TXT); tft.drawRect(x + 1, 206, 41, 13, HR_TXT); }
}
void mxStrip(int s) {
  int t = HS->m[s].type, x = 2 + s * 45;
  tft.fillRect(x, 40, 43, 181, HR_BG);
  tft.fillRect(x, 40, 43, 12, HR_PAN[t]);
  putText(x + (43 - (int)strlen(HR_TSHORT[t]) * 6) / 2, 42, 1, HR_COL[t], HR_PAN[t], HR_TSHORT[t]);
  if (!t) return;
  mxFader(s); mxVu(s, true); mxPan(s); mxSend(s); mxState(s);
}
void mxItem(int f) {
  if (f < 6) { hrDrawBar(f); return; }
  int s = (f - 6) / 4, k = (f - 6) % 4;
  if (!HS->m[s].type) return;
  if (k == 0) mxFader(s); else if (k == 1) mxPan(s); else if (k == 2) mxSend(s); else mxState(s);
}
void mxHint() {
  if (hrEdit >= 0) hrHint(FS("turn: change   press: done"));
  else if (hrFocus >= 6 && (hrFocus - 6) % 4 == 3) hrHint(FS("press: on -> mute -> solo   hold: back"));
  else if (hrFocus >= 6 && (hrFocus - 6) % 4 == 1) hrHint(FS("PAN: left..right, past R64: ~ sweeps (bars)"));
