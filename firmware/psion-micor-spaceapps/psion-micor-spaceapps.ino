volatile bool oledFault = false;                     // a transfer wasn't acknowledged: the panel may have restarted
uint16_t oledRecovered = 0;                          // times it came back after that (WiFi > About device shows it)
void oledLock() { if (oledMx) xSemaphoreTake(oledMx, portMAX_DELAY); }
void oledUnlock() { if (oledMx) xSemaphoreGive(oledMx); }
void oledWrite(uint8_t ctl, const uint8_t* d, int n) {   // 0x00 = commands, 0x40 = pixels; 127 bytes a transfer
  while (n > 0) {
    int k = n > 127 ? 127 : n;
    Wire.beginTransmission(OLED_ADDR); Wire.write(ctl); Wire.write(d, k);
    if (Wire.endTransmission() != 0) oledFault = true;   // (4.2.1) not acknowledged
    d += k; n -= k;
  }
}
void oledNote(const uint8_t* c, int n) {            // (4.2.1) remember what these commands set (see OledWant)
  for (int i = 0; i < n; i++) {
    uint8_t k = c[i];
    if (k == SSD1306_DISPLAYON) oledWant.on = true;
    else if (k == SSD1306_DISPLAYOFF) oledWant.on = false;
    else if (k == SSD1306_SETCONTRAST && i + 1 < n) oledWant.contrast = c[++i];
    else if (k == SSD1306_SETPRECHARGE && i + 1 < n) oledWant.precharge = c[++i];
    else if (k == SSD1306_SETVCOMDETECT && i + 1 < n) oledWant.vcomh = c[++i];
    else if (k == SSD1306_COLUMNADDR || k == SSD1306_PAGEADDR) i += 2;              // (their values aren't commands)
    else if (k == SSD1306_CHARGEPUMP || k == SSD1306_MEMORYMODE || k == SSD1306_SETMULTIPLEX || k == SSD1306_SETDISPLAYOFFSET ||
             k == SSD1306_SETDISPLAYCLOCKDIV || k == SSD1306_SETCOMPINS) i += 1;
  }
}
void oledCmds(const uint8_t* c, int n) { oledLock(); oledNote(c, n); oledWrite(0x00, c, n); oledUnlock(); }   // a command + its values, unbroken
void oledCmd2(uint8_t a, uint8_t b) { uint8_t c[2] = {a, b}; oledCmds(c, 2); }
void PsionOLED::ssd1306_command(uint8_t c) { oledCmds(&c, 1); }
void oledBand(const uint8_t* row, int p, int a, int b) {  // columns a..b of the 8-row band p
  uint8_t cmd[6] = {SSD1306_COLUMNADDR, (uint8_t)a, (uint8_t)b, SSD1306_PAGEADDR, (uint8_t)p, (uint8_t)p};
  oledWrite(0x00, cmd, 6);
  oledWrite(0x40, row + a, b - a + 1);
}
void oledSend(const uint8_t* buf) {                 // only what changed, band by band
  bool all = !oledSentOk;
  for (int p = 0; p < 8; p++) {
    const uint8_t* row = buf + p * 128; uint8_t* old = oledSent + p * 128;
    int a = 0, b = 127;
    if (!all) {
      while (a < 128 && row[a] == old[a]) a++;
      if (a == 128) continue;
      while (row[b] == old[b]) b--;
    }
    oledBand(row, p, a, b);
    memcpy(old + a, row + a, b - a + 1);
  }
  oledSentOk = true;
}
void oledSetAll() {                                 // (4.2.1) everything a panel needs, also right after it restarted
  const uint8_t set[] = {SSD1306_SETDISPLAYCLOCKDIV, 0x80, SSD1306_SETMULTIPLEX, 63, SSD1306_SETDISPLAYOFFSET, 0x00,
    SSD1306_SETSTARTLINE | 0x0, SSD1306_CHARGEPUMP, 0x14, SSD1306_MEMORYMODE, 0x00, SSD1306_SEGREMAP | 0x1, SSD1306_COMSCANDEC,
    SSD1306_SETCOMPINS, 0x12, SSD1306_SETCONTRAST, oledWant.contrast, SSD1306_SETPRECHARGE, oledWant.precharge,
    SSD1306_SETVCOMDETECT, oledWant.vcomh, SSD1306_DISPLAYALLON_RESUME, SSD1306_NORMALDISPLAY, SSD1306_DEACTIVATE_SCROLL,
    (uint8_t)(oledWant.on ? SSD1306_DISPLAYON : SSD1306_DISPLAYOFF)};   // (the same values as Adafruit's begin(), 128 x 64)
  oledWrite(0x00, set, sizeof set);
}
void oledTask(void*) {                              // core 1, next to loop(): while I2C sends, loop() keeps going
  static uint8_t work[1024];
  uint32_t healAt = 0, setAt = 0, faultAt = 0; uint8_t heal = 0;
  for (;;) {
    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(100));
    bool have = false;
    portENTER_CRITICAL(&oledMux);
    if (oledHasPend) { memcpy(work, oledPend, 1024); oledHasPend = false; have = true; }
    portEXIT_CRITICAL(&oledMux);
    uint32_t now = millis();
    oledLock();
    if (oledFault) {                                // (4.2.1) the panel didn't answer: it may have restarted
      if (have) { memcpy(oledSent, work, 1024); have = false; }   // (the newest picture: sent whole once it's back)
      if (now - faultAt >= 1000) {                  // once a second (no flood on the wires): set it up again
        faultAt = now; oledFault = false;
        oledSetAll();
        if (!oledFault) {                           // it answered: the whole picture, and settings again in 5 s
          for (int p = 0; p < 8; p++) oledBand(oledSent + p * 128, p, 0, 127);
          if (!oledFault) { oledSentOk = true; setAt = now; if (oledRecovered < 65535) oledRecovered++; }
        }
      }
      oledUnlock();
      continue;
    }
    if (have) oledSend(work);
    if (oledSentOk && now - healAt >= 400) {       // a band again, in case a glitch changed it on the panel
      healAt = now; oledBand(oledSent + heal * 128, heal, 0, 127); heal = (heal + 1) & 7;
    }
    if (now - setAt >= 5000) {                      // the panel's settings again: all of them (4.2.1), so a panel that
      setAt = now;                                  // restarted unnoticed is back within 5 s (it was dark until power-off)
      oledSetAll();
    }
    oledUnlock();
  }
}
// (4.1.5) OLED position (Settings > OLED): the picture moved dx right / dy down, for a glass that doesn't sit in the
// middle of its window. Each column of 64 pixels is 8 bytes (one per band, the top pixel in bit 0): shifted as one number.
void oledShift(uint8_t* dst, const uint8_t* src, int dx, int dy) {
  for (int c = 0; c < 128; c++) {
    int sc = c - dx;
    uint64_t col = 0;
    if (sc >= 0 && sc < 128) for (int p = 0; p < 8; p++) col |= (uint64_t)src[p * 128 + sc] << (8 * p);
    col = dy >= 0 ? col << dy : col >> -dy;
    for (int p = 0; p < 8; p++) dst[p * 128 + c] = (uint8_t)(col >> (8 * p));
  }
}
int8_t oledDx = 0, oledDy = 0;                      // (from P.oledDx / P.oledDy: applySettings, the position page)
void PsionOLED::display() {
  if (rcViewer()) rcOled(getBuffer());
  static uint8_t* moved = nullptr;                   // (4.2: 1 KB, made only if a position is set; no RAM = unmoved)
  const uint8_t* pic = getBuffer();
  if (oledDx || oledDy) { if (!moved) moved = (uint8_t*)malloc(1024); if (moved) { oledShift(moved, pic, oledDx, oledDy); pic = moved; } }
  if (!oledTaskH) { oledLock(); oledSend(pic); oledUnlock(); return; }   // (before the task runs: right now)
  portENTER_CRITICAL(&oledMux);
  memcpy(oledPend, pic, 1024); oledHasPend = true;   // (the newest picture wins if the task is still busy)
  portEXIT_CRITICAL(&oledMux);
  xTaskNotifyGive(oledTaskH);
}
void oledStart() {                                  // setup(), after oled.begin()
  oledMx = xSemaphoreCreateMutex();
  xTaskCreatePinnedToCore(oledTask, "oled", 3072, nullptr, 2, &oledTaskH, 1);
}

char* ringBuf() { static char b[6][64]; static uint8_t r = 0; r = (r + 1) % 6; return b[r]; }
const char* fstr(PGM_P p) { char* o = ringBuf(); strncpy_P(o, p, 63); o[63] = 0; return o; }
const char* pgmItem(PGM_P list, int k) {          // k-th line of a newline-separated flash list
  char* o = ringBuf();
  int n = 0;
  for (char c; (c = pgm_read_byte(list)); list++) {
    if (c == '\n') { if (k-- == 0) break; continue; }
    if (k == 0 && n < 63) o[n++] = c;
  }
  o[n] = 0;
  return o;
}

